#!/usr/bin/env python3
"""Installed context handoff in a disposable user unit; not fleet G3 acceptance."""

from __future__ import annotations

import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import subprocess
import time
import uuid
from pathlib import Path
from tempfile import TemporaryDirectory

ROOT = Path(__file__).resolve().parent.parent
loader = importlib.machinery.SourceFileLoader(
    "context_accept_reader", str(ROOT / "scripts/read-contract")
)
spec = importlib.util.spec_from_loader(loader.name, loader)
reader = importlib.util.module_from_spec(spec)
loader.exec_module(reader)
KEYS = (
    "PATH",
    "XDG_RUNTIME_DIR",
    "NIRI_SOCKET",
    "DISPLAY",
    "WAYLAND_DISPLAY",
    "SSH_AUTH_SOCK",
    "TMUX_TMPDIR",
    "TMUX_OBSERVER_HOST_ID",
)


def command(argv, *, env=None, ok=True):
    result = subprocess.run(argv, env=env, capture_output=True, timeout=30, check=False)
    if ok and result.returncode:
        raise RuntimeError(result.stderr.decode(errors="replace")[:2048])
    return result


def until(predicate, *, budget=5):
    deadline = time.monotonic() + budget
    while time.monotonic() < deadline:
        value = predicate()
        if value:
            return value
        time.sleep(0.03)
    raise RuntimeError("owned context acceptance condition expired")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    evidence = {
        "gate": "T12-context",
        "endpoint": "Snap",
        "sourceCommit": command(["git", "rev-parse", "HEAD"]).stdout.decode().strip(),
        "sourceTreeDirty": bool(command(["git", "status", "--porcelain"]).stdout),
        "systemdVersion": command(["systemctl", "--version"]).stdout.decode().splitlines()[0],
        "cases": [],
        "limits": [
            "Context/unit and prepared startup only; no two-host/native-source/desktop G3 acceptance",
            "Private candidate paths, not managed deployment or lingering policy acceptance",
        ],
    }

    def passed(name, **details):
        evidence["cases"].append({"name": name, "result": "passed", **details})
        print("passed " + name, flush=True)

    with TemporaryDirectory(prefix="tmux-ctx-native-") as temporary:
        directory = Path(temporary)
        wheel_dir = directory / "wheel"
        command(["uv", "build", "--wheel", "--out-dir", str(wheel_dir)])
        wheel = next(wheel_dir.glob("*.whl"))
        evidence["wheelSha256"] = hashlib.sha256(wheel.read_bytes()).hexdigest()
        venv = directory / "venv"
        command(["uv", "venv", str(venv)])
        python = str(venv / "bin/python")
        command(["uv", "pip", "install", "--python", python, "--no-deps", str(wheel)])
        template = venv / "share/tmux-observer/systemd/tmux-observer-fleet@.service"
        assert template.read_bytes() == (ROOT / "systemd/tmux-observer-fleet@.service").read_bytes()
        evidence["templateSha256"] = hashlib.sha256(template.read_bytes()).hexdigest()
        runtime = directory / "runtime"
        runtime.mkdir(mode=0o700)
        env = dict(
            os.environ,
            XDG_RUNTIME_DIR=str(runtime),
            DISPLAY=':9 "quote" \\backslash $dollar `backtick`',
            NIRI_SOCKET=str(directory / "owned compositor.sock"),
            WAYLAND_DISPLAY="owned-wayland",
            SSH_AUTH_SOCK="/owned/agent.sock",
            TMUX_TMPDIR=str(directory),
            TMUX="/ambient/alternate",
            TMUX_PANE="%999",
            OBSERVER_ACCEPT_SECRET="not captured",
        )
        client = str(venv / "bin/tmux-observer-client")
        management_env = dict(
            env,
            DBUS_SESSION_BUS_ADDRESS=os.environ.get(
                "DBUS_SESSION_BUS_ADDRESS", f"unix:path=/run/user/{os.getuid()}/bus"
            ),
        )
        captured = json.loads(
            command(
                [client, "prepare-context", "--host-id", "fixture-context", "--json"], env=env
            ).stdout
        )
        context = captured["contextId"]
        capture = Path(captured["environmentFile"])
        assert capture.stat().st_mode & 0o777 == 0o600
        assert "OBSERVER_ACCEPT_SECRET" not in capture.read_text()
        assert "ambient/alternate" not in capture.read_text()
        alternate_env = dict(env, NIRI_SOCKET=str(directory / "another compositor.sock"))
        alternate = json.loads(
            command(
                [client, "prepare-context", "--host-id", "fixture-context", "--json"],
                env=alternate_env,
            ).stdout
        )
        alternate_path = Path(alternate["environmentFile"])
        alternate_bytes = alternate_path.read_bytes()
        output = directory / "probe.json"
        probe = directory / "probe.py"
        probe.write_text(
            "import json,os,subprocess,sys,time\n"
            "from pathlib import Path\n"
            "from tmux_observer_client.public import desktop_context_id\n"
            "child=subprocess.Popen([sys.executable,'-c','import time;time.sleep(300)'])\n"
            f"values={{key:os.environ.get(key) for key in {KEYS!r}}}\n"
            "values.update(context=desktop_context_id(),pid=os.getpid(),child=child.pid,"
            "tmux=os.environ.get('TMUX'),pane=os.environ.get('TMUX_PANE'))\n"
            f"Path({str(output)!r}).write_text(json.dumps(values))\n"
            "time.sleep(300)\n"
        )
        unit = "tmux-observer-context-accept-" + uuid.uuid4().hex + ".service"
        unit_file = directory / unit
        candidate = (
            template.read_text()
            .replace("%i", context)
            .replace(
                "%h/.local/share/tmux-observer/bin/tmux-observer-client fleet --host-id ${TMUX_OBSERVER_HOST_ID} --context-id "
                + context,
                python + " " + str(probe),
            )
            .replace("%t/tmux-observer-client/context-" + context + ".env", str(capture))
        )
        candidate = candidate.replace(
            "[Service]\n",
            "[Service]\nEnvironment=DISPLAY=:888 NIRI_SOCKET=/inherited TMUX=/inherited\n",
        )
        unit_file.write_text(candidate)
        command(["systemd-analyze", "--user", "verify", str(unit_file)])
        expected = {key: env.get(key, "") for key in KEYS}
        expected["TMUX_OBSERVER_HOST_ID"] = "fixture-context"
        source_unit = captured["unit"]
        manager_runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
        # Native adapter maps one fixed candidate instance to this owned unit.
        adapter = (
            "import json,sys\nfrom tmux_observer_client._context import prepare_context,stop_context\n"
            "from tmux_observer_client._command import run_bounded\n"
            "def runner(argv,**kwargs):\n"
            f" assert argv[:2]==['systemctl','--user'] and argv[3]=={source_unit!r}\n"
            f" value=run_bounded(['/usr/bin/env','XDG_RUNTIME_DIR={manager_runtime}']+argv[:3]+[{unit!r}],**kwargs)\n"
            " if value.returncode: print('owned manager operation: '+value.stderr,file=sys.stderr)\n"
            " return value\n"
        )
        pids = []
        linked = False
        try:
            command(["systemctl", "--user", "link", "--runtime", str(unit_file)])
            linked = True
            value = json.loads(
                command(
                    [
                        python,
                        "-c",
                        adapter
                        + "print(json.dumps(prepare_context('fixture-context',start=True,runner=runner)))",
                    ],
                    env=management_env,
                ).stdout
            )
            assert value["state"] == "start_requested"

            def observed():
                try:
                    return json.loads(output.read_text())
                except (OSError, ValueError):
                    return None

            first = until(observed)
            pids += [first["pid"], first["child"]]
            assert {key: first[key] for key in KEYS} == expected
            assert first["context"] == context and first["tmux"] is None and first["pane"] is None
            assert output.stat().st_mode & 0o777 == 0o600
            passed(
                "installed_capture_and_literal_environment_parsing",
                keys=list(KEYS),
                contextId=context,
            )
            command(["systemctl", "--user", "restart", unit])
            second = until(
                lambda: value if (value := observed()) and value["pid"] != first["pid"] else None
            )
            pids += [second["pid"], second["child"]]
            assert {key: second[key] for key in KEYS} == expected
            assert second["context"] == context
            until(lambda: all(not Path(f"/proc/{pid}").exists() for pid in pids[:2]))
            passed("restart_reloads_capture_and_reaps_prior_owned_children")
            began = time.monotonic()
            stopped = json.loads(
                command(
                    [
                        python,
                        "-c",
                        adapter + f"print(json.dumps(stop_context({context!r},runner=runner)))",
                    ],
                    env=management_env,
                ).stdout
            )
            assert stopped["state"] == "stopped"
            until(lambda: all(not Path(f"/proc/{pid}").exists() for pid in pids))
            elapsed = round((time.monotonic() - began) * 1000, 3)
            assert elapsed < 5000
            assert not capture.exists() and alternate_path.read_bytes() == alternate_bytes
            passed("scoped_stop_removes_only_its_capture_and_owned_processes", stopMs=elapsed)
            # Exercise the actual installed fleet entry point and ${HOST} argv
            # expansion, separately from the literal-environment probe.
            command([client, "prepare-context", "--host-id", "fixture-context", "--json"], env=env)
            actual_unit = (
                template.read_text()
                .replace("%i", context)
                .replace(
                    "%h/.local/share/tmux-observer/bin/tmux-observer-client",
                    client,
                )
                .replace("%t/tmux-observer-client/context-" + context + ".env", str(capture))
            )
            unit_file.write_text(actual_unit)
            command(["systemctl", "--user", "daemon-reload"])
            command(
                [
                    python,
                    "-c",
                    adapter
                    + "print(json.dumps(prepare_context('fixture-context',start=True,runner=runner)))",
                ],
                env=management_env,
            )
            fleet_path = runtime / "tmux-observer-client" / ("fleet-" + context + ".sock")

            def prepared():
                value = command(
                    [
                        client,
                        "snapshot",
                        "--access",
                        "cached",
                        "--context-id",
                        context,
                        "--expected-host",
                        "fixture-context",
                        "--socket",
                        str(fleet_path),
                        "--json",
                    ],
                    env=env,
                    ok=False,
                )
                return value.stdout if value.returncode == 0 else None

            raw = until(prepared)
            frame = reader.wire(raw, 1064960)
            reader.verify("fleet-frame", frame)
            assert frame["contextId"] == context
            assert frame["snapshot"]["mesh"]["localHostId"] == "fixture-context"
            assert all(not host["sessions"] for host in frame["snapshot"]["hosts"])
            main_pid = int(
                command(
                    ["systemctl", "--user", "show", "--value", "--property=MainPID", unit]
                ).stdout
            )
            pids.append(main_pid)
            command(
                [
                    python,
                    "-c",
                    adapter + f"print(json.dumps(stop_context({context!r},runner=runner)))",
                ],
                env=management_env,
            )
            until(lambda: not fleet_path.exists() and not Path(f"/proc/{main_pid}").exists())
            assert alternate_path.read_bytes() == alternate_bytes
            passed(
                "installed_fleet_template_argv_context_and_prepared_startup",
                meshState=frame["snapshot"]["mesh"]["state"],
            )
        finally:
            if linked:
                command(["systemctl", "--user", "stop", unit], ok=False)
                command(["systemctl", "--user", "disable", "--runtime", unit], ok=False)
                command(["systemctl", "--user", "reset-failed", unit], ok=False)
            assert all(not Path(f"/proc/{pid}").exists() for pid in pids), (
                "owned probe process remains"
            )
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(json.dumps(evidence, indent=2) + "\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
