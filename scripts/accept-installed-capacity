#!/usr/bin/env python3
"""Installed fleet capacity with synthetic owners and local or actual SSH bridges.

No native tmux, compositor or ordinary service is touched. Optional --ssh-host
uses fifteen real SSH links to owned synthetic publishers on Starship.
"""

from __future__ import annotations

import argparse
import copy
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
import traceback
import uuid
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
LIMIT = 1064960


def command(argv, *, env=None):
    value = subprocess.run(argv, env=env, capture_output=True, check=False, timeout=60)
    if value.returncode:
        raise RuntimeError(value.stderr.decode(errors="replace")[:2048])
    return value.stdout


def write_json(path, value):
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps(value))
    temporary.chmod(0o600)
    temporary.replace(path)


def host_number(value):
    if not re.fullmatch(r"fixture-(?:0[0-9]|1[0-6])", value):
        raise ValueError("foreign fixture host")
    return int(value[-2:])


def remote_bundle(root):
    """Own remote synthetic publishers and account for every attributed bridge."""
    owners, bridges, samples = [], {}, []
    stop = threading.Event()
    lock = threading.Lock()

    def bridge_rows():
        result = []
        for path in root.glob("bridge-pid-fixture-*"):
            host_number(path.name.removeprefix("bridge-pid-"))
            try:
                pid = int(path.read_text())
                argv = Path(f"/proc/{pid}/cmdline").read_bytes()
            except (FileNotFoundError, ValueError):
                continue
            if str(root).encode() not in argv:
                continue
            rows = process_tree(pid)
            result.extend(rows)
            for row in rows:
                bridges[row["pid"], row["incarnation"]] = row
        unique = {row["pid"]: row for row in result}
        assert len(unique) <= 64
        return list(unique.values())

    def sample():
        while not stop.is_set():
            rows = bridge_rows()
            with lock:
                samples.append(
                    {
                        "atBootTimeMs": time.clock_gettime_ns(time.CLOCK_BOOTTIME) // 1000000,
                        "rssBytes": sum(row["rssBytes"] for row in rows),
                        "processes": rows,
                    }
                )
                assert len(samples) <= 12000
            stop.wait(0.1)

    sampler = threading.Thread(target=sample)
    try:
        for index in range(1, 16):
            host = f"fixture-{index:02d}"
            with (root / (host + ".stderr")).open("wb") as log:
                process = subprocess.Popen(
                    [
                        sys.executable,
                        "-I",
                        str(root / "worker"),
                        "--root",
                        str(root),
                        "--role",
                        "owner",
                        "--host",
                        host,
                    ],
                    stdout=subprocess.DEVNULL,
                    stderr=log,
                    start_new_session=True,
                )
            owners.append(process)
        deadline = time.monotonic() + 10
        while not all((root / f"fixture-{i:02d}.sock").exists() for i in range(1, 16)):
            if (
                any(process.poll() is not None for process in owners)
                or time.monotonic() >= deadline
            ):
                raise RuntimeError("owned remote capacity publishers failed to start")
            time.sleep(0.05)
        sampler.start()
        from tmux_observer._clock import domain

        wheel = next((root / "dist").glob("*.whl"))
        print(
            json.dumps(
                {
                    "ok": True,
                    "result": {
                        "wheelSha256": hashlib.sha256(wheel.read_bytes()).hexdigest(),
                        "clock": domain(),
                        "owners": 15,
                    },
                }
            ),
            flush=True,
        )
        while line := sys.stdin.buffer.readline(16385):
            if len(line) > 16384 or not line.endswith(b"\n"):
                raise ValueError("invalid owned bundle control")
            value = json.loads(line)
            operation = value["operation"]
            if operation == "close":
                break
            if operation == "settings":
                assert value["owners"] in (16, 17) and value["padding"] in (8, 14000)
                settings = json.loads((root / "settings.json").read_text())
                settings.update(owners=value["owners"], padding=value["padding"])
                write_json(root / "settings.json", settings)
                result = {}
            elif operation == "metrics":
                with lock:
                    assert sampler.is_alive()
                    assert (
                        time.clock_gettime_ns(time.CLOCK_BOOTTIME) // 1000000
                        - samples[-1]["atBootTimeMs"]
                        <= 1000
                    )
                    result = {
                        "sampleIntervalMs": 100,
                        "sampleCount": len(samples),
                        "peak": max(samples, key=lambda sample: sample["rssBytes"]),
                        "current": samples[-1],
                        "ownersAlive": sum(process.poll() is None for process in owners),
                    }
            else:
                raise ValueError("unsupported owned bundle control")
            print(json.dumps({"ok": True, "result": result}), flush=True)
    finally:
        stop.set()
        if sampler.ident is not None:
            sampler.join(timeout=3)
            assert not sampler.is_alive()
        for process in reversed(owners):
            if process.poll() is None:
                process.terminate()
                try:
                    process.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    os.killpg(process.pid, signal.SIGKILL)
                    process.wait(timeout=3)
        # Only captured root-qualified bridge incarnations may be signalled.
        # Ordinary publishers and SSH sessions are outside this owned roster.
        for row in bridges.values():
            try:
                fields = Path(f"/proc/{row['pid']}/stat").read_text().rpartition(") ")[2].split()
            except FileNotFoundError:
                continue
            if fields[19] == row["incarnation"] and fields[0] != "Z":
                try:
                    os.kill(row["pid"], signal.SIGTERM)
                except ProcessLookupError:
                    pass
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline:
            if not bridge_rows():
                break
            time.sleep(0.05)
        else:
            raise RuntimeError("owned remote bridge processes survived cleanup")


def worker(root, role, host):
    # Worker imports resolve only from the installed wheel under Python -I.
    info = root.lstat()
    assert root.is_dir() and not root.is_symlink()
    assert info.st_uid == os.getuid() and info.st_mode & 0o777 == 0o700
    if role == "bundle":
        remote_bundle(root)
        return 0
    from tmux_observer._clock import boottime_ms, domain

    if role == "context":
        from tmux_observer_client.public import desktop_context_id

        print(desktop_context_id())
        return 0
    if role == "owner":
        from tmux_observer.owner import OwnerPublisher

        host_number(host)
        fixture = json.loads((root / "observation.json").read_text())

        class SyntheticCollector:
            def __init__(self):
                self.source = {
                    "hostId": host,
                    "uid": os.getuid(),
                    "server": "default",
                    "nativeHostname": "fixture",
                }
                self.clock = domain()
                self.calls = 0

            def collect(self, *, budget_ms):
                started = boottime_ms()
                value = copy.deepcopy(fixture)
                self.calls += 1
                settings = json.loads((root / "settings.json").read_text())
                value.update(source=self.source, clock=self.clock)
                value["sample"].update(
                    startedAt=started,
                    finishedAt=boottime_ms(),
                    observedAt=time.time_ns() // 1000000,
                )
                row = value["sessions"][0]
                row["hostId"] = host
                for key in ("name", "sessionPath", "currentWindow", "currentPath"):
                    row[key] = "x" * settings["padding"]
                write_json(root / (host + ".count"), {"calls": self.calls})
                return value

        publisher = OwnerPublisher(
            host, path=root / (host + ".sock"), collector=SyntheticCollector()
        )
    elif role == "fleet":
        from tmux_observer_client.fleet import FleetPublisher
        from tmux_observer_client.mesh import MeshHost, MeshPolicy, MeshRoute, MeshSnapshot

        class FixtureMesh:
            def load(self, **_kwargs):
                settings = json.loads((root / "settings.json").read_text())
                count = settings["owners"]
                hosts = tuple(
                    MeshHost(
                        f"fixture-{index:02d}",
                        f"Fixture {index}",
                        index == 0,
                        (),
                        ()
                        if index == 0
                        else (
                            MeshRoute(
                                settings.get("sshHost", f"fixture-route-{index:02d}"), 0, None, None
                            ),
                        ),
                    )
                    for index in range(count)
                )
                return MeshSnapshot(
                    "sha256:" + ("a" if count == 16 else "b") * 64,
                    "fixture-00",
                    MeshPolicy(
                        "/usr/bin/ssh" if settings.get("sshHost") else str(root / "transport"),
                        1,
                        1,
                        60,
                    ),
                    hosts,
                )

            def report_route(self, **_kwargs):
                return True

        publisher = FleetPublisher(
            "fixture-00",
            path=root / "fleet.sock",
            owner_path=root / "fixture-00.sock",
            mesh=FixtureMesh(),
            remote_exec=shlex.quote(str(root / "bridge")),
        )
        original = publisher.publish_tickets
        next_metrics = 0
        high_water = {
            "readers": 0,
            "outputBytes": 0,
            "retainedBytes": 0,
            "connections": 0,
            "perPeerBytes": 0,
        }

        def metrics_tick(now):
            nonlocal next_metrics
            original(now)
            if now < next_metrics:
                return
            current = {
                "readers": len(publisher.hub.peers),
                "outputBytes": sum(peer.bytes_held() for peer in publisher.hub.peers),
                "retainedBytes": sum(publisher.retained.values()),
                "connections": len(publisher.connections),
                "perPeerBytes": max((peer.bytes_held() for peer in publisher.hub.peers), default=0),
            }
            for key, value in current.items():
                high_water[key] = max(high_water[key], value)
            write_json(root / "metrics.json", {"current": current, "highWater": high_water})
            next_metrics = now + 100

        publisher.publish_tickets = metrics_tick
    else:
        raise ValueError("unsupported worker role")
    signal.signal(signal.SIGTERM, lambda *_: publisher.stop())
    signal.signal(signal.SIGINT, lambda *_: publisher.stop())
    publisher.run()
    return 0


def independent_reader():
    loader = importlib.machinery.SourceFileLoader(
        "capacity_reader", str(ROOT / "scripts/read-contract")
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def record(sock, *, timeout=2, pending=None):
    deadline = time.monotonic() + timeout
    raw = bytearray() if pending is None else pending
    while b"\n" not in raw:
        sock.settimeout(max(0.001, deadline - time.monotonic()))
        chunk = sock.recv(min(65536, LIMIT + 1 - len(raw)))
        if not chunk:
            raise EOFError("owned publisher ended the fixture connection")
        raw.extend(chunk)
        if len(raw) > LIMIT or time.monotonic() >= deadline:
            raise TimeoutError("fixture frame exceeded byte/deadline bound")
    body, _separator, rest = raw.partition(b"\n")
    raw[:] = rest
    return bytes(body) + b"\n"


def request(root, context, operation="snapshot", *, keep=False, timeout=2, buffered=False):
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(timeout)
    retained = False
    try:
        sock.connect(str(root / "fleet.sock"))
        sock.sendall(
            json.dumps(
                {
                    "protocol": "tmux-observer.fleet.v1",
                    "schemaVersion": 1,
                    "operation": operation,
                    "requestId": uuid.uuid4().hex,
                    "contextId": context,
                    "expectedHost": "fixture-00",
                }
            ).encode()
            + b"\n"
        )
        pending = bytearray()
        raw = record(sock, timeout=timeout, pending=pending)
        if keep:
            retained = True
            return (sock, raw, pending) if buffered else (sock, raw)
        return raw
    finally:
        if not retained:
            sock.close()


def process_tree(pid):
    pending, seen, processes = [pid], set(), []
    while pending:
        selected = pending.pop()
        if selected in seen or len(seen) >= 128:
            continue
        seen.add(selected)
        path = Path(f"/proc/{selected}")
        try:
            fields = (path / "stat").read_text().rpartition(") ")[2].split()
            rss = int((path / "statm").read_text().split()[1]) * os.sysconf("SC_PAGE_SIZE")
            children = (path / f"task/{selected}/children").read_text().split()
            processes.append(
                {
                    "pid": selected,
                    "incarnation": fields[19],
                    "name": (path / "comm").read_text().strip(),
                    "rssBytes": rss,
                }
            )
            pending.extend(map(int, children))
        except (FileNotFoundError, ProcessLookupError):
            continue
    return processes


def main(output, memory_target_mib, ssh_host=None, artifact=None):
    source_commit = command(["git", "-C", str(ROOT), "rev-parse", "HEAD"]).decode().strip()
    dirty = bool(command(["git", "-C", str(ROOT), "status", "--porcelain"]).strip())
    evidence = {
        "gate": "T12-installed-synthetic-capacity-partial",
        "sourceCommit": source_commit,
        "sourceTreeDirty": dirty,
        "cases": [],
        "scope": "one installed wheel; synthetic 16-owner catalog/observations; real private IPC and 15 installed local stdio bridges",
        "limits": [
            "Fixture transport execs local bridges with SSH-shaped argv; no SSH process or network costs are measured",
            "Synthetic facts/catalog do not establish native tmux, Host Mesh, remote clocks or desktop truth",
            "100 ms RSS samples can miss transient peaks; this is not a ten-minute idle CPU profile",
            "Fixture owners/readers/coordinator are outside the fleet tree; every fleet bridge child is included",
            "The fleet worker includes the fixture tool imports; bridge processes use the plain installed CLI",
        ],
    }
    if ssh_host:
        evidence["gate"] = "T12-installed-ssh-capacity-partial"
        evidence["scope"] = (
            "one installed wheel; 16 synthetic owners across Snap/Starship; 15 real strict SSH links and installed plain remote bridges"
        )
        evidence["limits"][0] = (
            "Actual SSH processes/network are included; sixteen logical owner scopes use two physical endpoints"
        )
        evidence["limits"][3] = (
            "Synthetic owners/readers/coordinator are outside fleet accounting; all SSH children and associated remote bridges are included"
        )
    reader = independent_reader()
    owned, watchers, sampler_stop = [], [], threading.Event()
    samples = []
    failure = None
    remote, remote_created, remote_profile = None, False, None
    with tempfile.TemporaryDirectory(prefix="tmux-observer-capacity-") as temporary:
        root = Path(temporary)
        root.chmod(0o700)
        env = dict(os.environ)
        for key in (
            "PYTHONPATH",
            "PYTHONHOME",
            "TMUX",
            "TMUX_PANE",
            "NIRI_SOCKET",
            "DISPLAY",
            "WAYLAND_DISPLAY",
        ):
            env.pop(key, None)
        env.update(
            PYTHONNOUSERSITE="1",
            XDG_CONFIG_HOME=str(root / "config"),
            XDG_CACHE_HOME=str(root / "cache"),
        )
        for name in ("config", "cache", "dist"):
            (root / name).mkdir(mode=0o700)
        from artifact_input import stage_wheel

        wheel = stage_wheel(root / "dist", evidence, repo=ROOT, descriptor=artifact, env=env)
        evidence["wheelSha256"] = hashlib.sha256(wheel.read_bytes()).hexdigest()
        command(["uv", "venv", str(root / "venv")], env=env)
        command(
            [
                "uv",
                "pip",
                "install",
                "--python",
                str(root / "venv/bin/python"),
                "--no-deps",
                str(wheel),
            ],
            env=env,
        )
        # Foreground timing includes the installed production codec/validator.
        # Independent schema verification remains separate acceptance work.
        if any(
            name == "tmux_observer" or name.startswith("tmux_observer.") for name in sys.modules
        ):
            raise RuntimeError("capacity coordinator already imported a producer implementation")
        site = next((root / "venv/lib").glob("python*/site-packages"))
        sys.path.insert(0, str(site))
        from tmux_observer import public as installed_codec

        assert Path(installed_codec.__file__).is_relative_to(root / "venv")
        shutil.copyfile(Path(__file__).resolve(), root / "worker")
        shutil.copyfile(
            ROOT / "contracts/observation-v1/fixtures/complete.json", root / "observation.json"
        )
        base = [str(root / "venv/bin/python"), "-I", str(root / "worker"), "--root", str(root)]
        (root / "transport").write_text(
            '#!/bin/sh\nfor program do :; done\nexec /bin/sh -c "$program"\n'
        )
        (root / "transport").chmod(0o700)
        (root / "bridge").write_text(
            '#!/bin/sh\n[ "$1" = bridge ] && [ "$2" = --expected-host ] || exit 64\n'
            'case "$3" in fixture-0[0-9]|fixture-1[0-5]) ;; *) exit 64 ;; esac\n'
            + "exec "
            + shlex.quote(str(root / "venv/bin/tmux-observer"))
            + ' "$@" --socket '
            + shlex.quote(str(root))
            + '/"$3".sock\n'
        )
        (root / "bridge").chmod(0o700)
        settings = {"owners": 16, "padding": 8}
        if ssh_host:
            settings["sshHost"] = ssh_host
        write_json(root / "settings.json", settings)
        context = command([*base, "--role", "context"], env=env).decode().strip()

        ssh = [
            "ssh",
            "-T",
            "-o",
            "BatchMode=yes",
            "-o",
            "StrictHostKeyChecking=yes",
            "-o",
            "ConnectTimeout=2",
            "-o",
            "ConnectionAttempts=1",
            "-o",
            "ControlMaster=no",
            "-o",
            "ControlPath=none",
            ssh_host or "starship",
        ]

        def configure(count, padding):
            settings.update(owners=count, padding=padding)
            write_json(root / "settings.json", settings)
            if remote is not None:
                remote.call("settings", owners=count, padding=padding)

        def start(role, host=None):
            args = [*base, "--role", role]
            if host is not None:
                args.extend(["--host", host])
            log = (root / (host or role)).with_suffix(".stderr")
            with log.open("wb") as stderr:
                process = subprocess.Popen(
                    args, env=env, stdout=subprocess.DEVNULL, stderr=stderr, start_new_session=True
                )
            owned.append(process)
            return process

        def frame():
            raw = request(root, context)
            value = reader.wire(raw, LIMIT)
            reader.verify("fleet-frame", value)
            return value, len(raw)

        def wait(condition, *, budget=20):
            until = time.monotonic() + budget
            while time.monotonic() < until:
                if any(process.poll() is not None for process in owned):
                    raise RuntimeError("an installed fixture publisher exited")
                try:
                    result = condition()
                except (OSError, EOFError, TimeoutError):
                    result = None
                if result:
                    return result
                time.sleep(0.1)
            raise TimeoutError("installed capacity condition did not complete")

        def passed(name, **details):
            evidence["cases"].append({"name": name, "result": "passed", **details})
            print("passed " + name, flush=True)

        fleet = None
        sampler = None
        descendants = []
        try:
            if ssh_host:
                command([*ssh, shlex.join(["mkdir", "-m", "700", "--", str(root)])], env=env)
                remote_created = True
                command(
                    [*ssh, shlex.join(["mkdir", "-m", "700", "--", str(root / "dist")])], env=env
                )
                command(
                    [
                        "scp",
                        "-q",
                        "-o",
                        "BatchMode=yes",
                        "-o",
                        "StrictHostKeyChecking=yes",
                        str(wheel),
                        ssh_host + ":" + str(root / "dist") + "/",
                    ],
                    env=env,
                )
                for name in ("worker", "observation.json", "settings.json"):
                    command(
                        [
                            "scp",
                            "-q",
                            "-o",
                            "BatchMode=yes",
                            "-o",
                            "StrictHostKeyChecking=yes",
                            str(root / name),
                            ssh_host + ":" + str(root) + "/",
                        ],
                        env=env,
                    )
                command([*ssh, shlex.join(["uv", "venv", str(root / "venv")])], env=env)
                command(
                    [
                        *ssh,
                        shlex.join(
                            [
                                "uv",
                                "pip",
                                "install",
                                "--python",
                                str(root / "venv/bin/python"),
                                "--no-deps",
                                str(root / "dist" / wheel.name),
                            ]
                        ),
                    ],
                    env=env,
                )
                # Record the exact installed plain bridge PID before exec; no
                # fault relay or measurement import runs in a bridge process.
                text = (
                    (root / "bridge")
                    .read_text()
                    .replace(
                        "exec ",
                        "printf '%s\\n' \"$$\" > "
                        + shlex.quote(str(root))
                        + '/bridge-pid-"$3"\nexec ',
                        1,
                    )
                )
                (root / "remote-bridge").write_text(text)
                command(
                    [
                        "scp",
                        "-q",
                        "-o",
                        "BatchMode=yes",
                        "-o",
                        "StrictHostKeyChecking=yes",
                        str(root / "remote-bridge"),
                        ssh_host + ":" + str(root / "bridge"),
                    ],
                    env=env,
                )
                command([*ssh, shlex.join(["chmod", "700", str(root / "bridge")])], env=env)
                loader = importlib.machinery.SourceFileLoader(
                    "capacity_control", str(ROOT / "scripts/accept-native-fleet")
                )
                spec = importlib.util.spec_from_loader(loader.name, loader)
                helper = importlib.util.module_from_spec(spec)
                loader.exec_module(helper)
                remote = helper.Control(
                    [
                        *ssh,
                        shlex.join(
                            [
                                str(root / "venv/bin/python"),
                                "-I",
                                str(root / "worker"),
                                "--root",
                                str(root),
                                "--role",
                                "bundle",
                            ]
                        ),
                    ]
                )
                bootstrap = remote.receive()
                assert bootstrap["wheelSha256"] == evidence["wheelSha256"]
                evidence["remoteEndpoint"] = bootstrap
            for index in range(1 if ssh_host else 16):
                start("owner", f"fixture-{index:02d}")
            wait(
                lambda: all(
                    (root / f"fixture-{i:02d}.sock").exists() for i in range(1 if ssh_host else 16)
                )
            )
            fleet = start("fleet")

            def sample():
                while not sampler_stop.is_set():
                    rows = process_tree(fleet.pid)
                    samples.append(
                        {
                            "at": time.monotonic_ns() // 1000000,
                            "rssBytes": sum(row["rssBytes"] for row in rows),
                            "processes": rows,
                        }
                    )
                    sampler_stop.wait(0.1)

            sampler = threading.Thread(target=sample)
            sampler.start()

            def complete():
                value, size = frame()
                hosts = value["snapshot"]["hosts"]
                return (
                    (value, size)
                    if len(hosts) == 16
                    and all(
                        host["owner"]["localExpiry"] > value["encodedAt"] and host["sessions"]
                        for host in hosts
                    )
                    else None
                )

            _initial, initial_size = wait(complete)
            passed(
                "sixteen_installed_owners_join_current_snapshots_through_one_watch_each",
                frameBytes=initial_size,
            )
            if ssh_host:
                local_tree = process_tree(fleet.pid)
                remote_metrics = remote.call("metrics")
                assert sum(row["name"] == "ssh" for row in local_tree) == 15
                assert len(remote_metrics["current"]["processes"]) == 15
                passed(
                    "fifteen_actual_ssh_links_join_distinct_remote_owner_scopes_with_attributed_plain_bridges"
                )
            with ThreadPoolExecutor(max_workers=32) as pool:
                futures = [
                    pool.submit(request, root, context, "watch", keep=True) for _ in range(32)
                ]
                failures = []
                for future in futures:
                    try:
                        sock, raw = future.result()
                        watchers.append(sock)
                        reader.verify("fleet-frame", reader.wire(raw, LIMIT))
                    except Exception as error:  # noqa: BLE001 - retain every owned socket before propagating
                        failures.append(error)
                if failures:
                    raise failures[0]
            metrics = wait(
                lambda: (
                    (value if value["current"]["readers"] == 32 else None)
                    if (value := json.loads((root / "metrics.json").read_text()))
                    else None
                )
            )
            assert metrics["current"]["connections"] == 16
            passed("thirty_two_watchers_share_sixteen_owner_connections")
            extra = json.loads(request(root, context, "watch"))
            assert extra["kind"] == "operation_error" and extra["error"]["code"] == "capacity"
            passed("thirty_third_reader_receives_explicit_capacity_error")
            # Observe nonreading subscribers across heartbeats, then require
            # healthy query progress. Small frames may fit kernel socket buffers;
            # this phase alone cannot establish the stalled-writer cutoff.
            time.sleep(9)
            metrics = json.loads((root / "metrics.json").read_text())
            assert metrics["highWater"]["readers"] <= 32
            assert metrics["highWater"]["outputBytes"] <= 72 * 1024 * 1024
            assert metrics["highWater"]["retainedBytes"] <= 16 * 1048576
            assert metrics["highWater"]["perPeerBytes"] <= 2 * LIMIT + 65536
            for sock in watchers:
                sock.close()
            watchers.clear()
            wait(complete)
            passed(
                "nonreading_watchers_keep_logical_memory_bounds_and_healthy_reader_progress",
                highWater=metrics["highWater"],
            )
            configure(16, 14000)
            _large, large_size = wait(
                lambda: (value if value[1] >= 850000 else None) if (value := complete()) else None
            )
            passed(
                "near_cap_aggregate_is_complete_untruncated_independently_readable",
                frameBytes=large_size,
            )
            if ssh_host:
                watch_buffers = {}
                initial_frames = []
                with ThreadPoolExecutor(max_workers=32) as pool:
                    futures = [
                        pool.submit(request, root, context, "watch", keep=True, buffered=True)
                        for _ in range(32)
                    ]
                    failures = []
                    for future in futures:
                        try:
                            sock, raw, pending = future.result()
                            watchers.append(sock)
                            watch_buffers[sock] = pending
                            assert len(raw) >= 850000
                            initial_frames.append(raw)
                        except Exception as error:  # noqa: BLE001 - retain all admitted owned sockets
                            failures.append(error)
                    if failures:
                        raise failures[0]
                durations = evidence["nearCapRpcMs"] = []
                breakdown = evidence["nearCapRpcPhases"] = []
                healthy = watchers[-1]
                for query_index in range(10):
                    started = time.monotonic()
                    progress = {
                        "index": query_index,
                        "phase": "awaiting_record",
                        "records": 0,
                        "receiveMs": 0.0,
                        "decodeMs": 0.0,
                        "validateMs": 0.0,
                    }
                    evidence["pendingNearCapQuery"] = progress
                    request_id = uuid.uuid4().hex
                    healthy.sendall(
                        json.dumps(
                            {
                                "protocol": "tmux-observer.fleet.v1",
                                "schemaVersion": 1,
                                "operation": "snapshot",
                                "requestId": request_id,
                                "contextId": context,
                                "expectedHost": "fixture-00",
                            }
                        ).encode()
                        + b"\n"
                    )
                    received = []
                    while True:
                        progress["phase"] = "awaiting_record"
                        remaining = 0.25 - (time.monotonic() - started)
                        progress["elapsedMs"] = (time.monotonic() - started) * 1000
                        assert remaining > 0
                        phase_start = time.monotonic()
                        raw = record(healthy, timeout=remaining, pending=watch_buffers[healthy])
                        progress["receiveMs"] += (time.monotonic() - phase_start) * 1000
                        progress["phase"] = "decoding"
                        phase_start = time.monotonic()
                        value = installed_codec.decode_document(raw, limit=LIMIT)
                        progress["decodeMs"] += (time.monotonic() - phase_start) * 1000
                        progress["phase"] = "validating"
                        phase_start = time.monotonic()
                        value = installed_codec.validate_fleet_frame(value)
                        progress["validateMs"] += (time.monotonic() - phase_start) * 1000
                        progress["records"] += 1
                        progress["phase"] = "validated_record"
                        received.append(raw)
                        if value["requestId"] == request_id:
                            break
                    durations.append((time.monotonic() - started) * 1000)
                    progress["phase"] = "validated_reply"
                    progress["elapsedMs"] = durations[-1]
                    breakdown.append(dict(progress))
                    assert durations[-1] <= 250
                    for raw in received:
                        reader.verify("fleet-frame", reader.wire(raw, LIMIT))
                    time.sleep(0.3)
                del evidence["pendingNearCapQuery"]
                metrics = json.loads((root / "metrics.json").read_text())
                assert metrics["highWater"]["outputBytes"] <= 72 * 1024 * 1024
                assert metrics["highWater"]["perPeerBytes"] <= 2 * LIMIT + 65536
                # Near-cap replacement records exceed kernel buffers. Require
                # actual stalled-reader retirement, rather than inferring it
                # from a small-frame phase that can stay fully buffered.
                wait(
                    lambda: (
                        json.loads((root / "metrics.json").read_text())["current"]["readers"] == 1
                    ),
                    budget=10,
                )
                for sock in watchers:
                    sock.close()
                watchers.clear()
                # Complete independent schema checks after the pressure window.
                # Otherwise serial verification of 32 MiB-sized records makes
                # the designated healthy subscriber stop consuming for seconds.
                for raw in initial_frames:
                    reader.verify("fleet-frame", reader.wire(raw, LIMIT))
                wait(complete)
                passed(
                    "thirty_two_simultaneous_readers_receive_complete_near_cap_frames_over_sixteen_current_owners"
                )
                passed(
                    "near_cap_nonreaders_retire_while_healthy_cached_queries_keep_the_250ms_deadline",
                    rpcMs=durations,
                    highWater=metrics["highWater"],
                )
            configure(17, 14000)

            def over_capacity():
                value, _size = frame()
                return value if value["snapshot"]["mesh"]["state"] == "capacity" else None

            rejected = wait(over_capacity, budget=25)
            assert rejected["snapshot"]["error"]["code"] == "capacity"
            assert len(rejected["snapshot"]["hosts"]) == 16
            assert all(host["owner"]["localExpiry"] == 0 for host in rejected["snapshot"]["hosts"])
            passed("seventeenth_catalog_owner_fails_authority_without_truncated_success")
            descendants = process_tree(fleet.pid)
            started = time.monotonic()
            fleet.terminate()
            fleet.wait(timeout=5)
            for row in descendants:
                path = Path(f"/proc/{row['pid']}/stat")
                if path.exists():
                    fields = path.read_text().rpartition(") ")[2].split()
                    assert fields[19] != row["incarnation"] or fields[0] == "Z"
            assert not (root / "fleet.sock").exists()
            assert all(process.poll() is None for process in owned[:-1])
            if remote is not None:
                deadline = time.monotonic() + 5
                while (remote_profile := remote.call("metrics"))["current"]["processes"]:
                    assert time.monotonic() < deadline
                    time.sleep(0.05)
                assert remote_profile["ownersAlive"] == 15
                assert not remote_profile["current"]["processes"]
            passed(
                "fleet_stop_reaps_owned_bridge_tree_and_preserves_fixture_owners",
                elapsedMs=round((time.monotonic() - started) * 1000, 3),
            )
        except Exception as error:  # noqa: BLE001 - preserve failed fixture evidence before cleanup
            failure = error
            evidence["result"] = "failed_native_case"
            location = traceback.extract_tb(error.__traceback__)[-1]
            evidence["failure"] = {
                "type": type(error).__name__,
                "message": str(error)[:512],
                "location": {
                    "script": Path(location.filename).name,
                    "line": location.lineno,
                    "function": location.name,
                },
            }
            if "pendingNearCapQuery" in evidence and progress["phase"] != "validated_reply":
                progress["elapsedMs"] = (time.monotonic() - started) * 1000
            evidence["cleanup"] = "pending"
            output.parent.mkdir(parents=True, exist_ok=True)
            output.write_text(json.dumps(evidence, indent=2) + "\n")
        finally:
            sampler_stop.set()
            if sampler is not None:
                sampler.join(timeout=3)
                assert not sampler.is_alive()
            for sock in watchers:
                sock.close()
            known = {
                (row["pid"], row["incarnation"]): row
                for sample in samples
                for row in sample["processes"]
            }
            if fleet is not None:
                known.update(
                    {(row["pid"], row["incarnation"]): row for row in process_tree(fleet.pid)}
                )
            descendants = list(known.values())
            for process in reversed(owned):
                if process.poll() is None:
                    process.terminate()
                    try:
                        process.wait(timeout=5)
                    except subprocess.TimeoutExpired:
                        os.killpg(process.pid, signal.SIGKILL)
                        process.wait(timeout=3)
            # Exceptional publisher termination must also reap the exact owned
            # bridge incarnations before removing their private backing files.
            for row in descendants:
                path = Path(f"/proc/{row['pid']}/stat")
                if path.exists():
                    fields = path.read_text().rpartition(") ")[2].split()
                    if fields[19] == row["incarnation"] and fields[0] != "Z":
                        try:
                            os.killpg(row["pid"], signal.SIGKILL)
                        except ProcessLookupError:
                            pass
            deadline = time.monotonic() + 5
            while time.monotonic() < deadline:
                running = []
                for row in descendants:
                    try:
                        fields = (
                            Path(f"/proc/{row['pid']}/stat").read_text().rpartition(") ")[2].split()
                        )
                    except FileNotFoundError:
                        continue
                    if fields[19] == row["incarnation"] and fields[0] != "Z":
                        running.append(row["pid"])
                if not running:
                    break
                time.sleep(0.03)
            else:
                raise RuntimeError("owned bridge incarnations survived fixture cleanup")
            if remote is not None:
                remote.close()
            if remote_created:
                command([*ssh, shlex.join(["rm", "-rf", "--", str(root)])], env=env)
    if failure is not None:
        evidence["cleanup"] = "completed_owned_fixture_and_backing_removal"
        evidence["limits"].append(
            "Resource profile incomplete after a failed native case; no memory-target acceptance"
        )
        output.write_text(json.dumps(evidence, indent=2) + "\n")
        print(json.dumps({"result": evidence["result"], "failure": evidence["failure"]}))
        return 1
    peak = max(samples, key=lambda sample: sample["rssBytes"])
    attributed_bytes = peak["rssBytes"] + (
        remote_profile["peak"]["rssBytes"] if remote_profile else 0
    )
    evidence["profile"] = {
        "sampleIntervalMs": 100,
        "sampleCount": len(samples),
        "durationMs": samples[-1]["at"] - samples[0]["at"],
        "fleetAndBridgePeak": peak,
        "targetBytes": memory_target_mib * 1024 * 1024,
        "memoryTarget": "passed"
        if attributed_bytes <= memory_target_mib * 1024 * 1024
        else "failed",
    }
    if remote_profile:
        evidence["profile"]["associatedRemoteBridges"] = remote_profile
        evidence["profile"]["conservativeCombinedPeakBytes"] = attributed_bytes
    evidence["result"] = (
        "passed_partial"
        if evidence["profile"]["memoryTarget"] == "passed"
        else "failed_resource_target"
    )
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(evidence, indent=2) + "\n")
    print(
        json.dumps(
            {
                "result": evidence["result"],
                "cases": len(evidence["cases"]),
                "peakRssBytes": attributed_bytes,
            }
        )
    )
    return 0 if evidence["result"] == "passed_partial" else 1


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path)
    parser.add_argument("--artifact", type=Path, help="frozen candidate.json; skip wheel build")
    parser.add_argument("--memory-target-mib", type=int, choices=(256, 768), default=768)
    parser.add_argument("--root", type=Path)
    parser.add_argument("--role", choices=("owner", "fleet", "context", "bundle"))
    parser.add_argument("--ssh-host", choices=("starship",))
    parser.add_argument("--host")
    args, remaining = parser.parse_known_args()
    if args.artifact and (args.root or args.role or args.host):
        parser.error("--artifact is a coordinator input")
    if args.root is not None and args.role is not None and not remaining:
        raise SystemExit(worker(args.root, args.role, args.host))
    if args.output is None or remaining:
        parser.error("provide --output or a complete private worker invocation")
    raise SystemExit(main(args.output, args.memory_target_mib, args.ssh_host, args.artifact))
