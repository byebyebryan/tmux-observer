#!/usr/bin/env python3
"""Check new contract coverage, independent valid/invalid cases and frozen pins."""

import hashlib
import importlib.machinery
import importlib.util
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
loader = importlib.machinery.SourceFileLoader(
    "boundary_acceptance_reader", str(ROOT / "scripts/read-boundary-contract")
)
spec = importlib.util.spec_from_loader(loader.name, loader)
reader = importlib.util.module_from_spec(spec)
loader.exec_module(reader)
count = 0
for bundle in ("attachments-v1", "desktop-v1", "action-v1", "bindings-v1"):
    directory = ROOT / "contracts" / bundle
    entries = {}
    for line in (directory / "SHA256SUMS").read_text().splitlines():
        digest, name = line.split("  ", 1)
        assert name not in entries and not Path(name).is_absolute() and ".." not in Path(name).parts
        assert hashlib.sha256((directory / name).read_bytes()).hexdigest() == digest, name
        entries[name] = digest
    assert set(entries) == {
        p.relative_to(directory).as_posix()
        for p in directory.rglob("*")
        if p.is_file() and p.name != "SHA256SUMS"
    }
    assert list(entries) == sorted(entries)
    descriptor = json.loads((directory / "contract.json").read_text())
    assert descriptor["dependencies"] == {
        name: hashlib.sha256((ROOT / "contracts" / name / "SHA256SUMS").read_bytes()).hexdigest()
        for name in descriptor["dependencies"]
    }
    index = json.loads((directory / "fixtures/index.json").read_text())
    for case in index["cases"]:
        value = json.loads((directory / "fixtures" / case["file"]).read_text())
        accepted = True
        try:
            reader.verify(case["kind"], value)
        except (ValueError, KeyError, TypeError):
            accepted = False
        assert accepted == case["accept"], case
        count += 1
print(f"Verified 4 boundary bundles and {count} independent valid/invalid cases")
