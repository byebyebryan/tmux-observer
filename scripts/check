#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd -- "$repo_root"
export PYTHONPATH="$repo_root/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONDONTWRITEBYTECODE=1
python3 scripts/check-contracts
python3 -m unittest discover -s tests -v
python3 -m compileall -q src
ruff check src tests scripts/read-contract scripts/check-contracts scripts/update-contracts scripts/accept-native-collector scripts/probe-rofi-interaction
ruff format --check src tests scripts/read-contract scripts/check-contracts scripts/update-contracts scripts/accept-native-collector scripts/probe-rofi-interaction
git diff --check
git diff --cached --check
