#!/usr/bin/env python3
"""Installed local fleet/desktop acceptance with an owned Kitty/Niri viewer."""

from __future__ import annotations

import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import shutil
import signal
import socket
import subprocess
import threading
import time
import uuid
from pathlib import Path
from tempfile import TemporaryDirectory

ROOT = Path(__file__).resolve().parent.parent
LIMIT = 1064960
HOST = "fixture-desktop"


def command(argv, *, env=None, ok=True, cwd=None):
    result = subprocess.run(argv, env=env, cwd=cwd, capture_output=True, timeout=30, check=False)
    if ok and result.returncode:
        raise RuntimeError(result.stderr.decode(errors="replace")[:2048])
    return result


def boottime():
    return time.clock_gettime_ns(time.CLOCK_BOOTTIME) // 1000000


def record(sock):
    pending = bytearray()
    while b"\n" not in pending:
        chunk = sock.recv(65536)
        if not chunk:
            raise RuntimeError("owned endpoint ended before a complete record")
        pending.extend(chunk)
        if len(pending) > LIMIT:
            raise RuntimeError("owned desktop acceptance record bound exceeded")
    line, _, rest = pending.partition(b"\n")
    if rest:
        raise RuntimeError("unexpected extra owned response bytes")
    return bytes(line) + b"\n"


class WindowsProxy:
    """Owned socket replacement; forwards only Niri's read-only Windows request."""

    def __init__(self, path, upstream):
        self.path, self.upstream = path, upstream
        self.stop = threading.Event()
        self.listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.listener.bind(str(path))
        path.chmod(0o600)
        self.inode = path.stat().st_ino
        self.listener.listen(4)
        self.listener.settimeout(0.1)
        self.thread = threading.Thread(target=self.run)
        self.thread.start()

    def run(self):
        while not self.stop.is_set():
            try:
                client, _ = self.listener.accept()
            except TimeoutError:
                continue
            except OSError:
                return
            with client:
                try:
                    client.settimeout(1)
                    request = record(client)
                    if len(request) > 16384 or json.loads(request) != "Windows":
                        raise ValueError("owned proxy permits only native Windows reads")
                    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as native:
                        native.settimeout(1)
                        native.connect(self.upstream)
                        native.sendall(request)
                        reply = record(native)
                    client.sendall(reply)
                except (OSError, ValueError, RuntimeError):
                    # The production scanner must classify an unavailable read.
                    continue

    def close(self):
        self.stop.set()
        self.listener.close()
        self.thread.join(timeout=3)
        if self.thread.is_alive():
            raise RuntimeError("owned compositor proxy did not stop")
        if self.path.exists() and self.path.stat().st_ino == self.inode:
            self.path.unlink()


def worker(root, operation):
    assert root.is_dir() and not root.is_symlink()
    assert root.stat().st_uid == os.getuid() and root.stat().st_mode & 0o777 == 0o700
    from tmux_observer_client.public import desktop_context_id

    if operation == "context":
        print(json.dumps({"contextId": desktop_context_id()}))
        return
    from tmux_observer_client.fleet import FleetPublisher
    from tmux_observer_client.mesh import HostMeshAdapter

    # Explicit lookup injection isolates this local desktop test from ordinary
    # Mesh preferences. It proves no native Mesh absence or remote transport.
    publisher = FleetPublisher(
        HOST,
        path=root / ("headless.sock" if operation == "headless" else "fleet.sock"),
        owner_path=root / "owner.sock",
        mesh=HostMeshAdapter(which=lambda _: None),
    )
    signal.signal(signal.SIGTERM, lambda *_: publisher.stop())
    signal.signal(signal.SIGINT, lambda *_: publisher.stop())
    publisher.run()


def main(output, artifact=None):
    loader = importlib.machinery.SourceFileLoader(
        "desktop_accept_reader", str(ROOT / "scripts/read-contract")
    )
    reader = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(reader)
    env = dict(os.environ)
    manager = command(["systemctl", "--user", "show-environment"]).stdout.decode()
    for line in manager.splitlines():
        key, separator, value = line.partition("=")
        if separator and key in ("DISPLAY", "WAYLAND_DISPLAY", "XDG_RUNTIME_DIR", "NIRI_SOCKET"):
            env[key] = value
    upstream = env.get("NIRI_SOCKET")
    if not upstream or not shutil.which("kitty"):
        raise RuntimeError("native Snap Kitty/Niri context is required")
    original_windows = json.loads(command(["niri", "msg", "--json", "windows"], env=env).stdout)
    focused = next((row["id"] for row in original_windows if row.get("is_focused")), None)
    evidence = {
        "gate": "T12-native-local-desktop-partial",
        "sourceCommit": command(["git", "rev-parse", "HEAD"]).stdout.decode().strip(),
        "sourceTreeDirty": bool(command(["git", "status", "--porcelain"]).stdout.strip()),
        "endpoint": "snap",
        "nativeVersion": command(["tmux", "-V"]).stdout.decode().strip(),
        "kittyVersion": command(["kitty", "--version"]).stdout.decode().strip(),
        "nativeIdentity": {
            "uid": os.getuid(),
            "hostname": command(["hostname"]).stdout.decode().strip(),
            "clock": {
                "bootId": Path("/proc/sys/kernel/random/boot_id").read_text().strip(),
                "timeNamespace": "time:" + str(os.stat("/proc/self/ns/time").st_ino),
            },
        },
        "scope": "one installed wheel; private default tmux server, owner/fleets and read-only compositor proxy; owned Kitty viewer",
        "cases": [],
        "limits": [
            "Injected missing Mesh lookup; no remote owner/manual SSH or native Mesh acceptance",
            "Owned proxy relays actual read-only Niri Windows responses; ordinary compositor socket is unchanged",
            "Native desktop evidence does not establish Rofi rendering, physical display or managed rollout",
            "Starship native graphical acceptance and declared-capacity/resource profiles remain separate",
        ],
    }

    def passed(name, **details):
        evidence["cases"].append({"name": name, "result": "passed", **details})
        print("passed " + name, flush=True)

    with TemporaryDirectory(prefix="tmux-observer-desktop-") as temporary:
        root = Path(temporary)
        os.chmod(root, 0o700)
        desktop_env = dict(env, TMUX_TMPDIR=str(root), NIRI_SOCKET=str(root / "desktop.sock"))
        for key in (
            "TMUX",
            "TMUX_PANE",
            "ROFI_TMUX_PLUS_VIEWER_V1",
            "KITTY_PID",
            "KITTY_WINDOW_ID",
            "KITTY_LISTEN_ON",
            "PYTHONPATH",
            "PYTHONHOME",
        ):
            desktop_env.pop(key, None)
        desktop_env["PYTHONNOUSERSITE"] = "1"
        for key in ("XDG_CONFIG_HOME", "XDG_CACHE_HOME", "XDG_STATE_HOME"):
            directory = root / key.lower()
            directory.mkdir(mode=0o700)
            desktop_env[key] = str(directory)
        native_prefix = ["tmux", "-u", "-f", "/dev/null", "-L", "default"]
        owned_processes = []
        proxies = []
        proxy = None
        native_identity = None

        def native(*args, ok=True):
            return command([*native_prefix, *args], env=desktop_env, ok=ok).stdout.decode().strip()

        def generation():
            path = native("display-message", "-p", "#{socket_path}")
            started = native("display-message", "-p", "#{start_time}")
            pid = native("display-message", "-p", "#{pid}")
            return f"tmux-v1:{started}:{pid}:{path}"

        def truth():
            rows = {}
            for line in native(
                "list-sessions",
                "-F",
                "#{session_id}|#{session_created}|#{session_attached}|#{session_windows}|#{session_name}",
            ).splitlines():
                sid, created, attached, windows, name = line.split("|")
                rows[sid] = {
                    "sessionId": sid,
                    "createdAt": int(created),
                    "attachedClients": int(attached),
                    "windowCount": int(windows),
                    "name": name,
                }
            return {
                "generation": generation(),
                "sessions": rows,
                "hooks": {sid: native("show-hooks", "-t", sid) for sid in rows},
            }

        def spawn(argv, selected_env=desktop_env):
            log = (root / ("process-" + uuid.uuid4().hex + ".log")).open("wb")
            try:
                process = subprocess.Popen(argv, env=selected_env, cwd=root, stdout=log, stderr=log)
            finally:
                log.close()
            owned_processes.append(process)
            return process

        def stop(process):
            if process.poll() is None:
                process.terminate()
                process.wait(timeout=5)

        def start_proxy():
            value = WindowsProxy(root / "desktop.sock", upstream)
            proxies.append(value)
            return value

        try:
            wheels = root / "wheel"
            from artifact_input import stage_wheel

            wheel = stage_wheel(wheels, evidence, repo=ROOT, descriptor=artifact)
            evidence["wheelSha256"] = hashlib.sha256(wheel.read_bytes()).hexdigest()
            venv = root / "venv"
            command(["uv", "venv", str(venv)])
            python = str(venv / "bin/python")
            command(["uv", "pip", "install", "--python", python, "--no-deps", str(wheel)])
            installed_tool = root / "accept-native-desktop"
            shutil.copyfile(Path(__file__), installed_tool)
            worker_prefix = [python, "-I", str(installed_tool), "--worker", str(root)]
            context = json.loads(
                command([*worker_prefix, "--operation", "context"], env=desktop_env).stdout
            )["contextId"]
            evidence["contextId"] = context
            prefix = "owned-" + uuid.uuid4().hex[:12]
            native("new-session", "-d", "-s", prefix + "-first", "sleep 3600")
            native("new-session", "-d", "-s", prefix + "-second", "sleep 3600")
            baseline = truth()
            native_pid = int(native("display-message", "-p", "#{pid}"))
            native_fields = Path(f"/proc/{native_pid}/stat").read_text().rpartition(") ")[2].split()
            native_identity = native_pid, native_fields[19]
            assert Path(native("display-message", "-p", "#{socket_path}")).is_relative_to(root)
            first, second = list(baseline["sessions"])
            evidence["nativeBaseline"] = baseline
            proxy = start_proxy()

            def start_owner():
                return spawn(
                    [
                        str(venv / "bin/tmux-observer"),
                        "owner",
                        "--host-id",
                        HOST,
                        "--socket",
                        str(root / "owner.sock"),
                    ]
                )

            owner = start_owner()
            fleet = spawn([*worker_prefix, "--operation", "fleet"])

            def frame(*, endpoint="fleet.sock", context_id=context):
                request = {
                    "protocol": "tmux-observer.fleet.v1",
                    "schemaVersion": 1,
                    "operation": "snapshot",
                    "requestId": uuid.uuid4().hex,
                    "expectedHost": HOST,
                    "contextId": context_id,
                }
                with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
                    client.settimeout(2)
                    client.connect(str(root / endpoint))
                    client.sendall(json.dumps(request).encode() + b"\n")
                    value = reader.wire(record(client), LIMIT)
                reader.verify("fleet-frame", value)
                assert value["contextId"] == context_id
                return value

            def rows(value):
                return {row["sessionId"]: row for row in value["snapshot"]["hosts"][0]["sessions"]}

            def current(value):
                host = value["snapshot"]["hosts"][0]
                return (
                    host["owner"]["localExpiry"] > value["encodedAt"]
                    and host["owner"]["receipt"]["state"] == "ready"
                )

            def until(predicate, *, timeout=10, **kwargs):
                deadline = time.monotonic() + timeout
                last, error = None, None
                while time.monotonic() < deadline:
                    try:
                        value = frame(**kwargs)
                        last = {
                            "desktop": value["snapshot"]["desktop"],
                            "viewers": {
                                sid: row["localViewer"] for sid, row in rows(value).items()
                            },
                        }
                        if predicate(value):
                            return value
                    except (OSError, RuntimeError, KeyError, IndexError) as problem:
                        error = str(problem)[:256]
                    time.sleep(0.03)
                raise RuntimeError(
                    "owned native desktop condition did not become true: " + str(error or last)
                )

            ready = until(
                lambda value: current(value) and value["snapshot"]["desktop"]["state"] == "ready"
            )
            actual_owner = ready["snapshot"]["hosts"][0]["owner"]
            assert actual_owner["source"]["uid"] == evidence["nativeIdentity"]["uid"]
            assert (
                actual_owner["source"]["nativeHostname"] == evidence["nativeIdentity"]["hostname"]
            )
            assert actual_owner["clock"] == ready["clock"] == evidence["nativeIdentity"]["clock"]
            assert all(row["localViewer"]["state"] == "none" for row in rows(ready).values())
            assert truth() == baseline
            for sid, expected in baseline["sessions"].items():
                row = rows(ready)[sid]
                assert row["serverGeneration"] == baseline["generation"] and row["hostId"] == HOST
                assert all(row[key] == expected[key] for key in expected)
            passed("installed_current_empty_viewer_observations_match_native_owner_and_compositor")

            viewer = spawn(
                [
                    "kitty",
                    "--config",
                    "NONE",
                    "--override",
                    "shell_integration=disabled",
                    "--title",
                    prefix,
                    "tmux",
                    "-u",
                    "-L",
                    "default",
                    "attach-session",
                    "-t",
                    first,
                ]
            )
            deadline = time.monotonic() + 8
            window = None
            while time.monotonic() < deadline:
                windows = json.loads(command(["niri", "msg", "--json", "windows"], env=env).stdout)
                window = next(
                    (
                        row
                        for row in windows
                        if row.get("pid") == viewer.pid and row.get("app_id") == "kitty"
                    ),
                    None,
                )
                if window is not None and truth()["sessions"][first]["attachedClients"] == 1:
                    break
                time.sleep(0.03)
            assert window is not None and viewer.poll() is None
            client_rows = native(
                "list-clients",
                "-F",
                "#{client_pid}|#{client_name}|#{session_id}|#{session_created}",
            ).splitlines()
            assert len(client_rows) == 1
            client_pid, client_name, client_sid, created = client_rows[0].split("|")
            assert client_sid == first and int(created) == baseline["sessions"][first]["createdAt"]
            ancestor = int(client_pid)
            for _ in range(12):
                if ancestor == viewer.pid:
                    break
                fields = Path(f"/proc/{ancestor}/stat").read_text().rpartition(") ")[2].split()
                ancestor = int(fields[1])
            assert ancestor == viewer.pid
            opened = until(
                lambda value: (
                    current(value)
                    and rows(value)[first]["localViewer"]
                    == {"state": "open", "confidence": "confirmed", "reason": None}
                )
            )
            assert rows(opened)[first]["attachedClients"] == 1
            attached_baseline = truth()
            evidence["nativeViewerJoin"] = {
                "windowId": window["id"],
                "windowPid": viewer.pid,
                "clientPid": int(client_pid),
                "reference": {
                    "hostId": HOST,
                    "serverGeneration": baseline["generation"],
                    "sessionId": first,
                    "createdAt": int(created),
                },
            }
            passed("actual_owned_kitty_window_and_native_client_join_prove_confirmed_open")

            native("switch-client", "-c", client_name, "-t", second)
            switched = until(
                lambda value: (
                    current(value)
                    and rows(value)[second]["localViewer"]["state"] == "open"
                    and rows(value)[first]["localViewer"]["state"] != "open"
                )
            )
            assert rows(switched)[second]["localViewer"]["confidence"] == "confirmed"
            assert (
                native("list-clients", "-F", "#{client_pid}|#{session_id}")
                == client_pid + "|" + second
            )
            assert rows(switched)[first]["attachedClients"] == 0
            # A conflicting launch argv may keep the old row unknown. It cannot
            # establish a positive on the original session after the live join.
            passed(
                "live_native_client_switch_confirms_current_reference_and_revokes_old_positive",
                previousViewer=rows(switched)[first]["localViewer"],
                currentViewer=rows(switched)[second]["localViewer"],
            )

            native("rename-session", "-t", second, prefix + "-renamed")
            renamed = until(
                lambda value: (
                    current(value)
                    and rows(value)[second]["name"] == prefix + "-renamed"
                    and rows(value)[second]["localViewer"]["state"] == "open"
                )
            )
            assert rows(renamed)[second]["serverGeneration"] == baseline["generation"]
            assert truth()["hooks"] == baseline["hooks"]
            passed("rename_preserves_complete_reference_and_rejoins_current_desktop_inputs")

            old_publisher = renamed["snapshot"]["hosts"][0]["owner"]["publisherId"]
            stop(owner)
            lost = until(
                lambda value: (
                    not current(value) and rows(value)[second]["localViewer"]["state"] == "unknown"
                )
            )
            assert lost["snapshot"]["hosts"][0]["owner"]["localExpiry"] == 0
            assert truth()["sessions"][second]["attachedClients"] == 1 and viewer.poll() is None
            owner = start_owner()
            restarted = until(
                lambda value: (
                    current(value) and rows(value)[second]["localViewer"]["state"] == "open"
                )
            )
            assert restarted["snapshot"]["hosts"][0]["owner"]["publisherId"] != old_publisher
            assert rows(restarted)[second]["serverGeneration"] == baseline["generation"]
            passed("owner_loss_invalidates_viewer_positives_and_new_owner_requires_desktop_rejoin")

            old_epoch = restarted["snapshot"]["desktop"]["epoch"]
            old_proxy = proxy
            old_path = root / "previous-desktop.sock"
            (root / "desktop.sock").rename(old_path)
            old_proxy.path = old_path
            changed_at = boottime()
            proxy = start_proxy()
            assert proxy.inode != old_proxy.inode
            old_proxy.close()
            replaced = until(lambda value: value["snapshot"]["desktop"]["epoch"] > old_epoch)
            if replaced["snapshot"]["desktop"]["state"] == "ready":
                assert replaced["snapshot"]["desktop"]["startedAt"] >= changed_at
            else:
                assert rows(replaced)[second]["localViewer"]["state"] == "unknown"
            recovered = until(
                lambda value: (
                    current(value) and rows(value)[second]["localViewer"]["state"] == "open"
                )
            )
            assert recovered["snapshot"]["desktop"]["startedAt"] >= changed_at
            assert rows(recovered)[second]["serverGeneration"] == baseline["generation"]
            passed("actual_owned_compositor_socket_replacement_invalidates_old_desktop_epoch")

            proxy.close()
            proxy = None
            failed = until(lambda value: value["snapshot"]["desktop"]["state"] == "failed")
            assert current(failed) and rows(failed)[second]["localViewer"]["state"] == "unknown"
            assert truth()["sessions"][second]["attachedClients"] == 1
            proxy = start_proxy()
            until(
                lambda value: (
                    current(value) and rows(value)[second]["localViewer"]["state"] == "open"
                )
            )
            passed("unavailable_compositor_is_independent_from_current_owner_and_attached_clients")

            headless_env = dict(desktop_env, NIRI_SOCKET="", DISPLAY="", WAYLAND_DISPLAY="")
            headless_context = json.loads(
                command([*worker_prefix, "--operation", "context"], env=headless_env).stdout
            )["contextId"]
            headless = spawn([*worker_prefix, "--operation", "headless"], headless_env)
            unsupported = until(
                lambda value: (
                    current(value) and value["snapshot"]["desktop"]["state"] == "unsupported"
                ),
                endpoint="headless.sock",
                context_id=headless_context,
            )
            assert rows(unsupported)[second]["localViewer"]["state"] == "unknown"
            assert (
                unsupported["snapshot"]["hosts"][0]["owner"]["publisherId"]
                == recovered["snapshot"]["hosts"][0]["owner"]["publisherId"]
            )
            stop(headless)
            assert viewer.poll() is None
            passed("headless_context_has_independent_unsupported_receipt_and_shared_owner")

            stop(viewer)
            closed = until(
                lambda value: (
                    current(value)
                    and all(
                        row["localViewer"]["state"] == "none" and row["attachedClients"] == 0
                        for row in rows(value).values()
                    )
                )
            )
            final = truth()
            assert final["generation"] == baseline["generation"]
            assert final["hooks"] == baseline["hooks"]
            assert all(
                row["windowCount"] == 1 and row["attachedClients"] == 0
                for row in final["sessions"].values()
            )
            assert all(
                row["createdAt"] == baseline["sessions"][sid]["createdAt"]
                for sid, row in final["sessions"].items()
            )
            evidence["finalFrame"] = closed
            evidence["nativeFinal"] = final
            evidence["attachedBaseline"] = attached_baseline
            stop(fleet)
            assert owner.poll() is None and truth() == final
            stop(owner)
            assert truth() == final
            passed(
                "viewer_and_service_stop_preserve_native_sessions_windows_hooks_and_creation_times"
            )
        finally:
            for process in reversed(owned_processes):
                if process.poll() is None:
                    process.terminate()
                    try:
                        process.wait(timeout=5)
                    except subprocess.TimeoutExpired:
                        process.kill()
                        process.wait(timeout=3)
            for proxy in reversed(proxies):
                proxy.close()
            native("kill-server", ok=False)
            if native_identity is not None:
                native_pid, incarnation = native_identity
                deadline = time.monotonic() + 5
                while time.monotonic() < deadline:
                    try:
                        fields = (
                            Path(f"/proc/{native_pid}/stat").read_text().rpartition(") ")[2].split()
                        )
                    except FileNotFoundError:
                        break
                    if fields[19] != incarnation or fields[0] == "Z":
                        break
                    time.sleep(0.03)
                else:
                    raise RuntimeError("owned native server did not exit before fixture removal")
            if focused is not None:
                command(
                    ["niri", "msg", "action", "focus-window", "--id", str(focused)],
                    env=env,
                    ok=False,
                )
    evidence["result"] = "passed_partial"
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(evidence, indent=2) + "\n")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path)
    parser.add_argument("--artifact", type=Path, help="frozen candidate.json; skip wheel build")
    parser.add_argument("--worker", type=Path)
    parser.add_argument("--operation", choices=("context", "fleet", "headless"))
    args = parser.parse_args()
    if args.artifact and (args.worker or args.operation):
        parser.error("--artifact is a coordinator input")
    if args.worker is not None and args.operation is not None:
        worker(args.worker, args.operation)
    elif args.output is not None:
        main(args.output, args.artifact)
    else:
        parser.error("provide --output or a complete private worker invocation")
