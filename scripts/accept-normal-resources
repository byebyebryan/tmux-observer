#!/usr/bin/env python3
"""Ten-minute installed two-host profile with passive desktop reads and no GUI input."""

import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import shlex
import shutil
import sys
import time
import uuid
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def load(path, name):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def worker(root, host, *, headless=False):
    helper = load(root / "accept-native-fleet", "normal_native_worker")
    endpoint = helper.Endpoint(
        root, host, native_fixture=False, python_executable="/usr/bin/python3"
    )
    # Capture only the read adapter's desktop context. No graphical launch,
    # focus command, keyboard synthesis, or ordinary preference mutation.
    manager = helper.command(["systemctl", "--user", "show-environment"]).stdout.decode()
    for line in manager.splitlines():
        key, separator, value = line.partition("=")
        if separator and key in ("NIRI_SOCKET", "DISPLAY", "WAYLAND_DISPLAY"):
            endpoint.env[key] = value
    assert headless or endpoint.env.get("NIRI_SOCKET"), (
        "passive desktop resource gate needs a captured endpoint"
    )
    try:
        value = endpoint.start()
        print(json.dumps({"ok": True, "result": value}), flush=True)
        while line := sys.stdin.buffer.readline(16385):
            if len(line) > 16384 or not line.endswith(b"\n"):
                raise ValueError("invalid owned normal-profile control record")
            request = json.loads(line)
            if request["operation"] == "close":
                break
            try:
                if request["operation"] == "associations":
                    from tmux_observer_client.attachments import read_local_attachments

                    frame = read_local_attachments(host, owner_path=root / "owner.sock")
                    result = {
                        "state": frame["receipt"]["state"],
                        "generation": frame["snapshot"]["serverGeneration"]
                        if frame["snapshot"]
                        else None,
                        "sessions": len(frame["snapshot"]["sessions"]) if frame["snapshot"] else 0,
                        "clients": len(frame["snapshot"]["clients"]) if frame["snapshot"] else 0,
                    }
                else:
                    result = endpoint.dispatch(request)
                print(json.dumps({"ok": True, "result": result}), flush=True)
            except Exception as error:  # noqa: BLE001 - owned control boundary
                print(
                    json.dumps(
                        {"ok": False, "code": type(error).__name__, "message": str(error)[:1024]}
                    ),
                    flush=True,
                )
    finally:
        endpoint.close()


def coordinate(
    artifact,
    output,
    *,
    transport="legacy",
    mesh_inputs=None,
    mesh_tuple=None,
    diagnostic_seconds=None,
    resource_scope="native-viewers",
):
    helper = load(ROOT / "scripts/accept-native-fleet", "normal_native_coordinator")
    root = Path("/tmp/to-fleet-" + uuid.uuid4().hex)
    root.mkdir(mode=0o700)
    ssh = ["ssh", "-T", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "starship"]
    controls = {}
    remote_created = False
    record = {
        "state": "running",
        "gate": (
            "B5-normal-resources"
            if resource_scope == "native-viewers"
            else "cached-delivery-resources"
        )
        if diagnostic_seconds is None
        else "resource-diagnostic",
        "resourceScope": resource_scope,
        "viewerAcceptance": resource_scope == "native-viewers",
        "desktopAcceptance": resource_scope != "headless-cached-delivery",
        "diagnosticSeconds": diagnostic_seconds,
        "scope": (
            "installed two-host owners passively observing ordinary default servers, real SSH and cached fleet delivery; private preferences/units/IPC only; desktop and viewer acceptance excluded"
            if resource_scope == "headless-cached-delivery"
            else "installed two-host owners passively observing ordinary default servers with enabled local associations, real SSH and actual Niri/process matching; private preferences/units/IPC only; no native mutation or GUI input"
        ),
        "cases": [],
        "endpoints": {},
        "cleanup": False,
        "transport": transport,
    }
    try:
        from artifact_input import stage_wheel

        wheel = stage_wheel(root / "wheel", record, repo=ROOT, descriptor=artifact)
        wheel.rename(root / wheel.name)
        wheel = root / wheel.name
        (root / "transport-kind").write_text(transport + "\n")
        if transport == "mesh":
            from mesh_acceptance import stage_mesh

            stage_mesh(root / "mesh-wheels", mesh_inputs, record, tuple_path=mesh_tuple)
        for name in ("accept-native-fleet", "accept-normal-resources", "mesh_acceptance.py"):
            shutil.copy2(ROOT / "scripts" / name, root / name)
        helper.command([*ssh, "mkdir -m 700 -- " + shlex.quote(str(root))])
        remote_created = True
        helper.command(
            [
                "scp",
                "-q",
                str(wheel),
                str(root / "accept-native-fleet"),
                str(root / "accept-normal-resources"),
                str(root / "mesh_acceptance.py"),
                str(root / "transport-kind"),
                "starship:" + str(root) + "/",
            ]
        )
        if transport == "mesh":
            helper.command(
                ["scp", "-q", "-r", str(root / "mesh-wheels"), "starship:" + str(root) + "/"]
            )
        for host in ("snap", "starship"):
            argv = [
                sys.executable,
                str(root / "accept-normal-resources"),
                "--worker",
                str(root),
                "--host-id",
                host,
                "--resource-scope",
                resource_scope,
            ]
            if host == "starship":
                argv = [*ssh, shlex.join(["python3", *argv[1:]])]
            controls[host] = helper.Control(argv)
            record["endpoints"][host] = controls[host].receive()
        expected = hashlib.sha256(wheel.read_bytes()).hexdigest()
        assert all(value["wheelSha256"] == expected for value in record["endpoints"].values())
        end = time.monotonic() + 25
        ready = set()
        record["readiness"] = {}
        while len(ready) < 2 and time.monotonic() < end:
            for host, control in controls.items():
                try:
                    frame = control.call("snapshot")["frame"]
                    view = frame["snapshot"]
                    associations = (
                        {"state": "not_assessed", "sessions": None, "clients": None}
                        if resource_scope == "headless-cached-delivery"
                        else control.call("associations")
                    )
                except RuntimeError as error:
                    if "owner publisher is unavailable" not in str(error):
                        raise
                    continue
                record["readiness"][host] = {
                    "mesh": view["mesh"] if view else None,
                    "desktop": view["desktop"]["state"] if view else None,
                    "owners": [
                        {
                            "hostId": row["hostId"],
                            "transport": row["owner"]["transport"],
                            "receipt": row["owner"]["receipt"],
                            "localExpiry": row["owner"]["localExpiry"],
                            "sessions": len(row["sessions"]),
                        }
                        for row in view["hosts"]
                    ]
                    if view
                    else [],
                    "associations": associations,
                }
                if (
                    view
                    and (
                        resource_scope == "headless-cached-delivery"
                        or view["desktop"]["state"] == "ready"
                    )
                    and len(view["hosts"]) == 2
                    and all(
                        row["owner"]["receipt"]
                        and row["owner"]["receipt"]["state"] == "ready"
                        and row["owner"]["localExpiry"] > frame["encodedAt"]
                        for row in view["hosts"]
                    )
                    and (
                        resource_scope == "headless-cached-delivery"
                        or (
                            associations["state"] == "ready"
                            and associations["sessions"]
                            == len(
                                record["endpoints"][host]["nativeReference"]["sessionReferences"]
                            )
                        )
                    )
                    and (
                        resource_scope in {"cached-delivery", "headless-cached-delivery"}
                        or (
                            associations["clients"] > 0
                            and any(
                                row["localViewer"].get("state") == "open"
                                or any(
                                    binding["association"]["state"] == "open"
                                    for binding in (source.get("localBindings") or {}).get(
                                        "rows", []
                                    )
                                )
                                for source in view["hosts"]
                                for row in source["sessions"]
                            )
                        )
                    )
                ):
                    ready.add(host)
                    record["endpoints"][host]["readyAssociationCounts"] = associations
            time.sleep(0.1)
        assert len(ready) == 2, "installed native profile/desktop inputs did not become current"
        record["cases"].append(
            "both_installed_native_profiles_and_cached_delivery_ready"
            if resource_scope == "headless-cached-delivery"
            else "both_installed_native_profiles_and_passive_desktop_readers_ready"
        )
        for host, control in controls.items():
            samples = control.call("benchmark")
            assert sorted(samples["rpcMs"])[94] <= 50
            assert sorted(samples["cliMs"])[94] <= 250
            record["endpoints"][host]["warmSamples"] = samples
        record["cases"].append("hundred_warm_queries_per_endpoint_meet_deadlines")
        for control in controls.values():
            control.call("profile_start", seconds=diagnostic_seconds or 600)
        print(
            "started "
            + ("diagnostic" if diagnostic_seconds else "ten-minute")
            + " profile; no graphical input on either host",
            flush=True,
        )
        end = time.monotonic() + (diagnostic_seconds or 600) + 120
        profiles = {}
        while len(profiles) < 2:
            assert time.monotonic() < end, "owned resource profile deadline exceeded"
            for host, control in controls.items():
                if host not in profiles:
                    profile = control.call("profile_status")
                    if profile["state"] == "complete":
                        profiles[host] = profile
            if len(profiles) < 2:
                time.sleep(10)
        record["backgroundProfiles"] = profiles
        assessments = {}
        for host, value in profiles.items():
            associated = profiles["starship" if host == "snap" else "snap"]
            fleet_bytes = (
                value["serviceMaxObservedRssBytes"]["fleet"]
                + associated["maxObservedBridgeRssBytes"]
            )
            owner_bytes = value["serviceMaxObservedRssBytes"]["owner"]
            cpu = sum(value["serviceCpuPercent"].values()) + associated["bridgeCpuPercent"]
            assessments[host] = {
                "fleetTargetMiB": 96,
                "ownerTargetMiB": 64,
                "combinedCpuTargetPercent": 5,
                "fleetAndAssociatedBridgeMaxObservedRssBytes": fleet_bytes,
                "ownerMaxObservedRssBytes": owner_bytes,
                "combinedCpuPercent": cpu,
                "withinSelectedTargets": fleet_bytes <= 96 * 1024**2
                and owner_bytes <= 64 * 1024**2
                and cpu <= 5,
            }
        record["normalResourceAssessment"] = assessments
        record["preservation"] = {}
        for host, control in controls.items():
            before = control.call("passivity")
            stopped = control.call("stop_fleet")
            after = control.call("passivity")
            record["preservation"][host] = {
                "beforeTeardown": before,
                "teardown": stopped,
                "afterTeardown": after,
            }
        record["cases"].append(
            "owned_fleet_teardown_preserves_native_references_generation_and_hooks"
        )
        record["state"] = (
            "passed"
            if all(row["withinSelectedTargets"] for row in assessments.values())
            else "failed_resource_target"
        )
        if diagnostic_seconds is not None:
            record["state"] = "diagnostic_complete"
            record["limits"] = ["Short diagnostics cannot establish normal resource acceptance"]
        else:
            record["limits"] = []
        record["limits"] += [
            "Sampled RSS can miss transient peaks",
            "Existing default-server clients and matching desktop windows are read passively; no viewer launch or Rofi proof",
            "Two physical hosts and private catalog/preferences; no managed selection",
        ]
        if resource_scope == "headless-cached-delivery":
            record["limits"].append(
                "Desktop readiness and positive viewer associations were not assessed"
            )
    except Exception as error:  # noqa: BLE001 - persist owned acceptance failures
        record.update(
            state="failed", failure=type(error).__name__, failureMessage=str(error)[:1024]
        )
    finally:
        for control in reversed(list(controls.values())):
            control.close()
        if remote_created:
            helper.command(
                [
                    *ssh,
                    shlex.join(
                        [
                            "python3",
                            str(root / "accept-native-fleet"),
                            "--cleanup",
                            str(root),
                            "--host-id",
                            "starship",
                        ]
                    ),
                ]
            )
            helper.command([*ssh, "rm -rf -- " + shlex.quote(str(root))])
        helper.cleanup(root, "snap")
        shutil.rmtree(root)
        record["cleanup"] = not root.exists()
        output.parent.mkdir(parents=True, exist_ok=True)
        output.write_text(json.dumps(record, indent=2) + "\n")
    print(json.dumps({"state": record["state"], "cleanup": record["cleanup"]}), flush=True)
    return 0 if record["state"] in {"passed", "diagnostic_complete"} and record["cleanup"] else 1


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--artifact", type=Path)
    parser.add_argument("--output", type=Path)
    parser.add_argument("--worker", type=Path)
    parser.add_argument("--host-id", choices=("snap", "starship"))
    parser.add_argument("--transport", choices=("legacy", "mesh"), default="legacy")
    parser.add_argument(
        "--resource-scope",
        choices=("native-viewers", "cached-delivery", "headless-cached-delivery"),
        default="native-viewers",
        help="cached-delivery has no positive viewer acceptance",
    )
    parser.add_argument("--mesh-wheels", type=Path)
    parser.add_argument("--mesh-tuple", type=Path, help="explicit reviewed Mesh input tuple")
    parser.add_argument(
        "--diagnostic-seconds",
        type=int,
        choices=range(10, 600),
        metavar="10..599",
        help="short diagnostic only; never produces acceptance",
    )
    args = parser.parse_args()
    if args.worker:
        worker(
            args.worker, args.host_id, headless=args.resource_scope == "headless-cached-delivery"
        )
        return 0
    if args.artifact is None or args.output is None:
        parser.error("coordinator requires a frozen artifact and output")
    if (args.transport == "mesh") != (args.mesh_wheels is not None):
        parser.error("Mesh transport requires --mesh-wheels; legacy does not use it")
    if args.mesh_tuple and args.transport != "mesh":
        parser.error("--mesh-tuple requires Mesh transport")
    return coordinate(
        args.artifact,
        args.output,
        transport=args.transport,
        mesh_inputs=args.mesh_wheels,
        mesh_tuple=args.mesh_tuple,
        diagnostic_seconds=args.diagnostic_seconds,
        resource_scope=args.resource_scope,
    )


if __name__ == "__main__":
    raise SystemExit(main())
