#!/usr/bin/env python3
"""Installed native B1 proof with owned servers/PTY clients; no graphical input."""

import argparse
import hashlib
import json
import os
import pty
import re
import subprocess
import sys
import tempfile
import threading
import time
import uuid
import zipfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def command(argv, *, env=None, timeout=5, check=True):
    return subprocess.run(
        argv, env=env, capture_output=True, text=True, timeout=timeout, check=check
    )


def wait_for(predicate, message, seconds=5):
    until = time.monotonic() + seconds
    while time.monotonic() < until:
        result = predicate()
        if result:
            return result
        time.sleep(0.03)
    raise AssertionError(message)


def worker(output, installed_root):
    from tmux_observer._clock import boottime_ms
    from tmux_observer._ipc import IPCError, exchange
    from tmux_observer._process import ReadRunner
    from tmux_observer.attachment_collector import AttachmentCollector, process_start
    from tmux_observer.attachments import ATTACHMENT_DELIVERY_PROTOCOL
    from tmux_observer.collector import Collector
    from tmux_observer.delivery import SERVICE_PROTOCOL
    from tmux_observer.owner import OwnerPublisher

    evidence = {
        "state": "running",
        "scope": "installed owned native server and PTY; no GUI",
        "cases": [],
        "cleanup": False,
    }
    for module_name in ("tmux_observer.owner", "tmux_observer.attachment_collector"):
        origin = Path(sys.modules[module_name].__file__).resolve()
        if not origin.is_relative_to(installed_root.resolve()):
            raise ValueError("worker imported checkout implementation")
    evidence["installedImportOriginsVerified"] = True
    original_env = dict(os.environ)
    for key in ("TMUX", "TMUX_PANE"):
        original_env.pop(key, None)
    ordinary_before = command(
        ["tmux", "-u", "-L", "default", "list-sessions", "-F", "#{session_id}\t#{session_created}"],
        env=original_env,
        check=False,
    )
    baseline = (
        set(ordinary_before.stdout.splitlines()) if ordinary_before.returncode == 0 else set()
    )
    clients = []
    publisher = thread = None
    fixture_env = None
    prefix = None
    temporary = tempfile.TemporaryDirectory(prefix="observer-native-associations-")
    try:
        path = Path(temporary.name)
        os.environ["TMUX_TMPDIR"] = str(path)
        fixture_env = {**original_env, "TMUX_TMPDIR": str(path), "TERM": "xterm-256color"}
        token = "observer-associations-" + uuid.uuid4().hex[:12]
        assert re.fullmatch(r"observer-associations-[0-9a-f]{12}", token)
        prefix = ["tmux", "-u", "-f", "/dev/null", "-L", token]

        def native(*args, check=True):
            return command([*prefix, *args], env=fixture_env, check=check).stdout.strip()

        def create(name):
            return native(
                "new-session", "-d", "-P", "-F", "#{session_id}", "-s", name, "sleep", "90"
            )

        first, second = create("fixture-a"), create("fixture-b")

        def attach(session_id):
            master, slave = pty.openpty()
            process = subprocess.Popen(
                [*prefix, "attach-session", "-t", session_id],
                stdin=slave,
                stdout=slave,
                stderr=slave,
                env=fixture_env,
                start_new_session=True,
            )
            os.close(slave)
            clients.append((process, master))
            wait_for(
                lambda: (
                    str(process.pid) in native("list-clients", "-F", "#{client_pid}").splitlines()
                ),
                "owned PTY did not attach",
            )
            return process

        client = attach(first)
        collector = Collector("fixture-local", runner=ReadRunner(tuple(prefix)))
        associations = AttachmentCollector(collector)

        def owner_request(operation="snapshot", **extra):
            return {
                "protocol": SERVICE_PROTOCOL,
                "schemaVersion": 1,
                "operation": operation,
                "requestId": uuid.uuid4().hex,
                "expectedHost": "fixture-local",
                **extra,
            }

        def profile_request():
            return {
                "protocol": ATTACHMENT_DELIVERY_PROTOCOL,
                "schemaVersion": 1,
                "operation": "snapshot",
                "requestId": uuid.uuid4().hex,
                "expectedHost": "fixture-local",
            }

        def controls():
            text = native(
                "list-sessions",
                "-F",
                "#{session_id}\t#{session_created}\t#{session_attached}\t#{session_last_attached}\t#{window_width}\t#{window_height}",
            )
            return {
                "sessions": text,
                "clients": native(
                    "list-clients", "-F", "#{client_pid}\t#{session_id}\t#{session_created}"
                ),
                "options": native("show-options", "-g"),
                "hooks": native("show-hooks", "-g"),
            }

        before = controls()
        publisher = OwnerPublisher(
            "fixture-local",
            path=path / "owner.sock",
            collector=collector,
            local_attachments=True,
        )
        thread = threading.Thread(target=publisher.run)
        thread.start()

        def current_profile(session_id):
            try:
                frame = exchange(profile_request(), path=publisher.attachment_path)
            except (OSError, IPCError):
                return False
            if frame["receipt"]["state"] != "ready":
                return False
            return (
                frame
                if any(
                    row["clientPid"] == client.pid and row["sessionRef"]["sessionId"] == session_id
                    for row in frame["snapshot"]["clients"]
                )
                else False
            )

        frame = wait_for(lambda: current_profile(first), "prepared native association not ready")
        assert next(row for row in frame["snapshot"]["clients"] if row["clientPid"] == client.pid)[
            "processStartTicks"
        ] == process_start(client.pid, os.getuid(), boottime_ms() + 500)
        evidence["cases"].append("installed_current_binding_and_process_incarnation")
        for _read in range(12):
            exchange(profile_request(), path=publisher.attachment_path)
            owner = exchange(owner_request(), path=publisher.path)
            assert (
                "clients" not in owner
                and "pidNamespace" not in owner
                and "localAttachments" not in owner
            )
        assert controls() == before
        evidence["cases"].append("reads_preserve_counts_last_attached_geometry_options_hooks")
        evidence["cases"].append("default_owner_export_contains_no_pid_roster")

        original_ref = next(
            row for row in frame["snapshot"]["sessions"] if row["sessionId"] == first
        )
        rename_attempt = frame["receipt"]["attempted"]
        native("rename-session", "-t", first, "fixture-renamed")
        exchange(
            owner_request("refresh", sources=[{"hostId": "fixture-local", "source": "owner"}]),
            path=publisher.path,
        )

        def after_rename():
            value = current_profile(first)
            owner = exchange(owner_request(), path=publisher.path)
            return (
                value
                if (
                    value
                    and value["receipt"]["attempted"] > rename_attempt
                    and owner["snapshot"] is not None
                    and any(
                        row["sessionId"] == first and row["name"] == "fixture-renamed"
                        for row in owner["snapshot"]["sessions"]
                    )
                )
                else False
            )

        renamed = wait_for(after_rename, "renamed reference lost association")
        assert (
            next(row for row in renamed["snapshot"]["sessions"] if row["sessionId"] == first)
            == original_ref
        )
        evidence["cases"].append("rename_preserves_complete_reference")

        tty = next(
            row.split("\t")[1]
            for row in native("list-clients", "-F", "#{client_pid}\t#{client_tty}").splitlines()
            if row.split("\t")[0] == str(client.pid)
        )
        native("switch-client", "-c", tty, "-t", second)
        exchange(
            owner_request("refresh", sources=[{"hostId": "fixture-local", "source": "owner"}]),
            path=publisher.path,
        )
        switched = wait_for(
            lambda: current_profile(second), "switch did not revoke previous current binding"
        )
        assert not any(
            row["clientPid"] == client.pid and row["sessionRef"]["sessionId"] == first
            for row in switched["snapshot"]["clients"]
        )
        evidence["cases"].append("native_switch_replaces_previous_association")

        basis = collector.collect()
        rejected = AttachmentCollector(
            collector,
            process_identity=lambda pid, uid, deadline: process_start(pid, uid + 1, deadline),
        ).sample(basis, boottime_ms() + 2000)
        assert rejected["sample"]["coverage"] == "failed" and not rejected["clients"]
        assert client.poll() is None
        evidence["cases"].append("real_process_uid_guard_rejects_without_client_effect")

        # Last native client exit must still destroy an opted-in owned session.
        disposable = create("fixture-destroy-unattached")
        last_client = attach(disposable)
        native("set-option", "-t", disposable, "destroy-unattached", "on")
        native("detach-client", "-s", disposable)
        wait_for(lambda: last_client.poll() is not None, "owned last client did not exit")
        wait_for(
            lambda: disposable not in native("list-sessions", "-F", "#{session_id}").splitlines(),
            "observer kept destroy-unattached session alive",
        )
        assert client.poll() is None
        evidence["cases"].append("observer_does_not_hold_destroy_unattached_session_alive")

        publisher.stop()
        thread.join(timeout=3)
        assert not thread.is_alive() and client.poll() is None
        assert not publisher.path.exists() and not publisher.attachment_path.exists()
        evidence["cases"].append("owner_stop_preserves_native_client_and_removes_owned_endpoints")
        publisher = thread = None

        # Replacing only this owned server must invalidate a reused session ID.
        old_generation = collector.collect()["serverGeneration"]
        native("kill-server")
        wait_for(lambda: client.poll() is not None, "owned client did not exit with owned server")
        replacement = create("fixture-replacement")
        basis = collector.collect()
        replaced = associations.sample(basis, boottime_ms() + 2000)
        assert replaced["sample"]["coverage"] == "complete"
        assert replaced["serverGeneration"] != old_generation and not replaced["clients"]
        assert all(row["serverGeneration"] != old_generation for row in replaced["sessions"])
        evidence["cases"].append("server_replacement_clears_old_associations")

        native("kill-server")

        def absent_server():
            observation = collector.collect()
            return (
                observation
                if (
                    observation["sample"]["coverage"] == "complete"
                    and observation["serverGeneration"] is None
                )
                else False
            )

        absent = wait_for(absent_server, "owned server teardown did not complete")
        empty = associations.sample(absent, boottime_ms() + 2000)
        evidence["noServerSample"] = empty["sample"]
        assert (
            empty["sample"]["coverage"] == "complete"
            and empty["serverGeneration"] is None
            and not empty["sessions"]
            and not empty["clients"]
        )
        evidence["cases"].append("no_server_is_complete_empty_without_activation")
        assert replacement
        ordinary_after = command(
            [
                "tmux",
                "-u",
                "-L",
                "default",
                "list-sessions",
                "-F",
                "#{session_id}\t#{session_created}",
            ],
            env=original_env,
            check=False,
        )
        assert baseline <= set(ordinary_after.stdout.splitlines())
        evidence["ordinaryDefaultReferencesPreserved"] = len(baseline)
        evidence["cases"].append("ordinary_default_references_preserved")
        evidence["state"] = "passed"
    except (AssertionError, OSError, ValueError, subprocess.SubprocessError) as problem:
        evidence.update(state="failed", failure=type(problem).__name__)
    finally:
        if publisher is not None:
            publisher.stop()
            thread.join(timeout=3)
        if prefix is not None and fixture_env is not None:
            command([*prefix, "kill-server"], env=fixture_env, check=False)
        for process, master in clients:
            if process.poll() is None:
                process.terminate()
            try:
                process.wait(timeout=3)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait(timeout=3)
            os.close(master)
        server_absent = True
        if prefix is not None and fixture_env is not None:
            probe = command([*prefix, "list-sessions"], env=fixture_env, check=False)
            server_absent = probe.returncode != 0
        evidence["cleanup"] = (
            (publisher is None or not thread.is_alive())
            and server_absent
            and all(process.poll() is not None for process, _master in clients)
        )
        temporary.cleanup()
        evidence["ownedTemporaryRootRemoved"] = not Path(temporary.name).exists()
        evidence["cleanup"] &= evidence["ownedTemporaryRootRemoved"]
        Path(output).write_text(json.dumps(evidence, indent=2) + "\n")
    return 0 if evidence["state"] == "passed" and evidence["cleanup"] else 1


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--artifact", type=Path)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--installed-root", type=Path, help=argparse.SUPPRESS)
    parser.add_argument("--worker", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.worker:
        if args.artifact is not None:
            parser.error("worker cannot select artifacts")
        if args.installed_root is None:
            parser.error("worker requires installed root")
        return worker(args.output, args.installed_root)
    from artifact_input import stage_wheel

    evidence = {
        "state": "preparing",
        "cases": [],
        "cleanup": False,
        "sourceTreeDirty": bool(command(["git", "-C", str(ROOT), "status", "--porcelain"]).stdout),
    }
    with tempfile.TemporaryDirectory(prefix="observer-association-install-") as temporary:
        stage = Path(temporary)
        wheel = stage_wheel(stage / "wheel", evidence, repo=ROOT, descriptor=args.artifact)
        target = stage / "python"
        command(
            ["uv", "pip", "install", "--no-deps", "--target", str(target), str(wheel)], timeout=30
        )
        with zipfile.ZipFile(wheel) as archive:
            members = [
                name
                for name in archive.namelist()
                if name.startswith(
                    ("tmux_observer/", "tmux_observer_client/", "tmux_observer_actions/")
                )
            ]
            assert members and all(
                (target / name).read_bytes() == archive.read(name) for name in members
            )
        evidence["installedPackageMembersVerified"] = len(members)
        env = {**os.environ, "PYTHONPATH": str(target), "PYTHONDONTWRITEBYTECODE": "1"}
        report = stage / "native.json"
        result = command(
            [
                sys.executable,
                str(Path(__file__).resolve()),
                "--worker",
                "--installed-root",
                str(target),
                "--output",
                str(report),
            ],
            env=env,
            timeout=40,
            check=False,
        )
        if report.is_file():
            evidence.update(json.loads(report.read_text()))
        else:
            evidence.update(state="failed", failure="worker_report_missing")
        evidence["wheelSha256"] = hashlib.sha256(wheel.read_bytes()).hexdigest()
        evidence["installedWorkerExit"] = result.returncode
    args.output.write_text(json.dumps(evidence, indent=2) + "\n")
    print(
        json.dumps(
            {
                "state": evidence["state"],
                "cases": len(evidence["cases"]),
                "cleanup": evidence["cleanup"],
            }
        )
    )
    return 0 if evidence["state"] == "passed" and result.returncode == 0 else 1


if __name__ == "__main__":
    raise SystemExit(main())
