#!/usr/bin/env python3
"""Prepare owned two-host sleep supervision; physical sleep is an explicit mode."""

from __future__ import annotations

import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import shlex
import shutil
import subprocess
import sys
import threading
import time
import uuid
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
ALARM = Path("/sys/class/rtc/rtc0/wakealarm")
LOGIN = [
    "busctl",
    "--system",
    "--timeout=10",
    "--json=short",
    "call",
    "org.freedesktop.login1",
    "/org/freedesktop/login1",
    "org.freedesktop.login1.Manager",
]


def load(path, name):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def command(argv, *, timeout=30):
    value = subprocess.run(argv, capture_output=True, timeout=timeout, check=False)
    if value.returncode:
        raise RuntimeError(value.stderr.decode(errors="replace")[:1024])
    return value


def clocks():
    # Both readings belong to this process's one clock domain. No host subtraction.
    mono = time.monotonic_ns() // 1_000_000
    boot = time.clock_gettime_ns(time.CLOCK_BOOTTIME) // 1_000_000
    return {
        "boottimeMs": boot,
        "monotonicMs": mono,
        "bootId": Path("/proc/sys/kernel/random/boot_id").read_text().strip(),
        "timeNamespace": "time:" + os.readlink("/proc/self/ns/time").split("[")[1][:-1],
    }


def inhibitors():
    value = json.loads(command([*LOGIN, "ListInhibitors"]).stdout)
    rows = value["data"][0]
    result = [{"what": row[0], "mode": row[3], "uid": row[4]} for row in rows]
    if any("sleep" in row["what"].split(":") and row["mode"].startswith("block") for row in result):
        raise RuntimeError("sleep-block inhibitor present; no alarm or suspend allowed")
    return result


def preflight():
    if not ALARM.exists() or ALARM.read_text().strip():
        raise RuntimeError("RTC0 missing or already armed; preserve existing alarm")
    state = Path("/sys/power/state").read_text().strip()
    if "mem" not in state.split():
        raise RuntimeError("native mem suspend unavailable")
    wakeup = Path("/sys/class/rtc/rtc0/device/power/wakeup")
    if not wakeup.exists() or wakeup.read_text().strip() != "enabled":
        raise RuntimeError("RTC0 wake capability is not enabled; do not change host configuration")
    can_suspend = json.loads(command([*LOGIN, "CanSuspend"]).stdout)["data"]
    if can_suspend not in (["yes"], ["challenge"]):
        raise RuntimeError("logind does not advertise permitted suspend")
    result = {
        "clock": clocks(),
        "powerState": state,
        "memSleep": Path("/sys/power/mem_sleep").read_text().strip(),
        "wakealarmBefore": "",
        "inhibitors": inhibitors(),
        "canSuspend": can_suspend,
        "rtcWakeup": "enabled",
    }
    command(
        [
            "sudo",
            "-n",
            "rtcwake",
            "--dry-run",
            "--mode",
            "no",
            "--seconds",
            "30",
            "--device",
            "rtc0",
        ]
    )
    if ALARM.read_text().strip():
        raise RuntimeError("alarm changed during dry preflight; preserve it")
    result["rtcDryRun"] = "passed_without_alarm_or_suspend"
    permission = (
        "import os; "
        "assert os.access('/sys/class/rtc/rtc0/wakealarm', os.R_OK|os.W_OK), 'RTC access unavailable'"
    )
    command(["sudo", "-n", "python3", "-I", "-c", permission])
    result["privilegedAlarmAccess"] = "read_only_check_passed"
    return result


def write_json(path, value):
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps(value) + "\n")
    temporary.chmod(0o600)
    temporary.replace(path)


def clear_owned_alarm(expected):
    # Compare and clear in the privileged process; never clear a replaced alarm.
    program = (
        "from pathlib import Path; import sys; "
        "p=Path('/sys/class/rtc/rtc0/wakealarm'); v=p.read_text().strip(); "
        "assert v in ('',sys.argv[1]), 'RTC alarm replaced; preserve it'; "
        "p.write_text('0') if v else None"
    )
    command(["sudo", "-n", "python3", "-I", "-c", program, expected])


def arm_alarm():
    # The sysfs interface rejects an already enabled alarm. Do not disable first.
    # +30 uses the RTC's own clock, including its configured offset from UTC.
    program = (
        "from pathlib import Path; "
        "p=Path('/sys/class/rtc/rtc0/wakealarm'); "
        "assert not p.read_text().strip(), 'RTC alarm already armed'; "
        "p.write_text('+30'); print(p.read_text().strip(), flush=True)"
    )
    value = command(["sudo", "-n", "python3", "-I", "-c", program]).stdout.decode().strip()
    if not value.isdecimal():
        raise RuntimeError("no armed RTC deadline returned")
    return value


def sleep_journal(before, after):
    try:
        raw = command(
            [
                "sudo",
                "-n",
                "journalctl",
                "-b",
                "-u",
                "systemd-suspend.service",
                "--output=json",
                "--no-pager",
                "-n",
                "20",
            ]
        ).stdout
        if len(raw) > 65536:
            raise ValueError("bounded suspend journal exceeded 64 KiB")
        records = []
        for line in raw.splitlines():
            row = json.loads(line)
            message = row.get("MESSAGE", "")
            if not isinstance(message, str):
                continue
            if "Performing sleep operation 'suspend'" in message:
                event = "suspend_entry"
            elif "System returned from sleep operation 'suspend'" in message:
                event = "suspend_return"
            else:
                continue
            mono = int(row["__MONOTONIC_TIMESTAMP"]) // 1000
            if (
                row.get("_BOOT_ID") == before["bootId"].replace("-", "")
                and before["monotonicMs"] - 1000 <= mono <= after["monotonicMs"] + 5000
            ):
                records.append(
                    {
                        "event": event,
                        "monotonicMs": mono,
                        "realtimeMs": int(row["__REALTIME_TIMESTAMP"]) // 1000,
                    }
                )
        return {"state": "captured" if records else "no_matching_records", "events": records}
    except Exception as error:  # noqa: BLE001 - journal access is supplementary evidence
        return {"state": "unavailable", "code": type(error).__name__}


def power(root):
    helper = load(root / "accept-native-fleet", "suspend_power_helper")
    helper.private_root(root)
    path = root / "power.json"
    result = {"state": "preflight", "alarmArmed": False}
    expected = None
    try:
        result["preflight"] = preflight()
        write_json(path, result)
        # Allow the controller to receive kickoff before its own host can sleep.
        time.sleep(2)
        result["inhibitorsAtArm"] = inhibitors()
        if ALARM.read_text().strip():
            raise RuntimeError("alarm changed before arming; preserve it")
        expected = arm_alarm()
        if ALARM.read_text().strip() != expected:
            raise RuntimeError("RTC deadline changed after owned arming; preserve its replacement")
        result.update(state="armed", alarmArmed=True, armedWakeEpoch=int(expected))
        result["inhibitorsAtSuspend"] = inhibitors()
        result["before"] = before = clocks()
        write_json(path, result)
        # Explicitly honour inhibitors, including when sudo is noninteractive.
        command(["sudo", "-n", "systemctl", "--check-inhibitors=yes", "suspend"], timeout=15)
        previous = before
        while clocks()["boottimeMs"] - before["boottimeMs"] < 90_000:
            after = clocks()
            gap = (
                after["boottimeMs"]
                - previous["boottimeMs"]
                - (after["monotonicMs"] - previous["monotonicMs"])
            )
            if gap >= 10_000:
                assert after["bootId"] == before["bootId"]
                assert after["timeNamespace"] == before["timeNamespace"]
                result.update(
                    state="resumed",
                    lastBefore=previous,
                    firstAfter=after,
                    suspendDeltaMs=gap,
                    actualWakeEpoch=time.time(),
                )
                result["nativeSuspendJournal"] = sleep_journal(before, after)
                break
            previous = after
            time.sleep(0.05)
        else:
            raise RuntimeError("no physical BOOTTIME/MONOTONIC suspend delta within 90 seconds")
    except Exception as error:  # noqa: BLE001 - terminal owned-power evidence
        result.update(
            state="failed", error={"code": type(error).__name__, "message": str(error)[:1024]}
        )
    finally:
        if expected:
            try:
                clear_owned_alarm(expected)
                result["ownedAlarmCleanup"] = "cleared_or_already_fired"
            except Exception as error:  # noqa: BLE001 - preserve a replaced RTC alarm
                result["ownedAlarmCleanup"] = {"error": str(error)[:1024]}
                result["state"] = "failed"
        write_json(path, result)
    return 0 if result["state"] == "resumed" else 1


def host_row(value, host):
    return next(row for row in value["snapshot"]["hosts"] if row["hostId"] == host)


def current(value, host):
    owner = host_row(value, host)["owner"]
    return bool(
        value["snapshot"]["mesh"]["state"] == "ready"
        and owner["receipt"]
        and owner["receipt"]["state"] == "ready"
        and owner["localExpiry"] > value["encodedAt"]
    )


def summary(value):
    hosts = {}
    for row in value["snapshot"]["hosts"]:
        owner = row["owner"]
        receipt, proof = owner["receipt"], owner["proof"]
        hosts[row["hostId"]] = {
            "current": current(value, row["hostId"]),
            "owner": {
                "publisherId": owner["publisherId"],
                "localExpiry": owner["localExpiry"],
                "transport": owner["transport"],
                "receipt": {
                    key: receipt[key] for key in ("state", "startedAt", "acceptedAt", "expiresAt")
                }
                if receipt
                else None,
                "proof": {key: proof[key] for key in ("requestId", "sentAt", "receivedAt")}
                if proof
                else None,
            },
        }
    return {
        "encodedAt": value["encodedAt"],
        "readerId": value["readerId"],
        "desktop": value["snapshot"]["desktop"],
        "hosts": hosts,
    }


class Monitor:
    def __init__(self, endpoint):
        self.endpoint = endpoint
        self.stop = threading.Event()
        self.records, self.frames = [], {}
        self.thread = threading.Thread(target=self.run, name="owned-suspend-monitor")

    def run(self):
        started = previous = clocks()
        invalid = False
        while not self.stop.is_set() and clocks()["boottimeMs"] - started["boottimeMs"] < 90_000:
            stamp = clocks()
            gap = (
                stamp["boottimeMs"]
                - previous["boottimeMs"]
                - (stamp["monotonicMs"] - previous["monotonicMs"])
            )
            record = {"clock": stamp, "suspendDeltaMs": max(0, gap)}
            if gap >= 10_000:
                record["lastBeforeLocalResume"] = previous
            previous = stamp
            try:
                response = self.endpoint.frame()
                value = response["frame"]
                record.update(summary(value), durationMs=response["durationMs"])
                remote = "starship" if self.endpoint.host_id == "snap" else "snap"
                if not self.frames:
                    self.frames["first"] = value
                if not current(value, remote) and not invalid:
                    invalid = True
                    self.frames["firstRemoteInvalid"] = value
                elif (
                    invalid and current(value, remote) and "firstRemoteRecovered" not in self.frames
                ):
                    self.frames["firstRemoteRecovered"] = value
            except Exception as error:  # noqa: BLE001 - bounded unavailable observations
                record["error"] = {
                    "code": getattr(error, "code", type(error).__name__),
                    "message": str(error)[:256],
                }
            if gap >= 10_000:
                record["firstResponseAfterLocalResume"] = (
                    value if "hosts" in record else {"unavailable": record["error"]}
                )
            self.records.append(record)
            if len(self.records) >= 450:
                break
            self.stop.wait(0.2)

    def finish(self):
        self.stop.set()
        self.thread.join(timeout=5)
        if self.thread.is_alive():
            raise RuntimeError("owned monitor did not stop")
        return {"samples": self.records, "frames": self.frames}


def native_truth(endpoint):
    return {
        "reference": endpoint.independent_native(),
        "roster": endpoint.roster(),
        "hooks": endpoint.native("show-hooks"),
        "geometry": endpoint.native(
            "list-panes",
            "-a",
            "-F",
            "#{window_id}|#{window_width}|#{window_height}|#{pane_id}|#{pane_width}|#{pane_height}",
        ),
    }


def worker(root, host):
    helper = load(root / "accept-native-fleet", "suspend_worker_helper")
    endpoint = helper.Endpoint(root, host)
    if host == "snap":
        for line in (
            command(["systemctl", "--user", "show-environment"]).stdout.decode().splitlines()
        ):
            key, sep, value = line.partition("=")
            if sep and key in ("NIRI_SOCKET", "DISPLAY", "WAYLAND_DISPLAY", "XDG_RUNTIME_DIR"):
                endpoint.env[key] = value
    monitor, power_process = None, None
    try:
        initial = endpoint.start()
        print(json.dumps({"ok": True, "result": initial}), flush=True)
        while line := sys.stdin.buffer.readline(16385):
            if len(line) > 16384 or not line.endswith(b"\n"):
                raise ValueError("invalid private worker record")
            request = json.loads(line)
            op = request["operation"]
            if op == "close":
                break
            try:
                if op == "preflight":
                    result = preflight()
                elif op == "native_truth":
                    result = native_truth(endpoint)
                elif op == "monitor_start":
                    if monitor is not None:
                        raise ValueError("monitor already exists")
                    monitor = Monitor(endpoint)
                    monitor.thread.start()
                    result = {"started": clocks()}
                elif op == "monitor_finish":
                    if monitor is None:
                        raise ValueError("monitor absent")
                    result = monitor.finish()
                    monitor = None
                elif op == "physical_suspend":
                    if power_process is not None or monitor is None:
                        raise ValueError("physical suspend requires one active owned monitor")
                    preflight()
                    with (root / "power.stderr").open("wb") as log:
                        power_process = subprocess.Popen(
                            [
                                sys.executable,
                                str(root / "accept-native-suspend"),
                                "--power",
                                str(root),
                            ],
                            stdout=log,
                            stderr=log,
                            start_new_session=True,
                        )
                    result = {"started": clocks(), "ownedPowerPid": power_process.pid}
                elif op == "power_status":
                    path = root / "power.json"
                    result = (
                        json.loads(path.read_bytes()) if path.exists() else {"state": "starting"}
                    )
                else:
                    result = endpoint.dispatch(request)
                print(json.dumps({"ok": True, "result": result}), flush=True)
            except Exception as error:  # noqa: BLE001 - private fixture failures
                print(
                    json.dumps(
                        {
                            "ok": False,
                            "code": getattr(error, "code", type(error).__name__),
                            "message": str(error)[:1024],
                        }
                    ),
                    flush=True,
                )
    finally:
        if monitor is not None:
            monitor.finish()
        if power_process is not None:
            # Never kill an alarm-owning helper; it must run its guarded cleanup.
            power_process.wait(timeout=100)
        endpoint.close()


def close_control(control):
    if control.process.poll() is None:
        control.process.stdin.write(b'{"operation":"close"}\n')
        control.process.stdin.flush()
        control.process.stdin.close()
        # An active power helper owns an alarm and must finish guarded cleanup.
        # If it does not, retain its backing directory for recovery; do not kill it.
        control.process.wait(timeout=125)
    control.process.stdout.close()
    control.process.stderr.close()


def coordinate(output, sleep_host, artifact=None):
    helper = load(ROOT / "scripts/accept-native-fleet", "suspend_coordinator_helper")
    reader = load(ROOT / "scripts/read-contract", "suspend_coordinator_reader")
    root = Path("/tmp/to-fleet-" + uuid.uuid4().hex)
    root.mkdir(mode=0o700)
    ssh = [
        "ssh",
        "-T",
        "-o",
        "BatchMode=yes",
        "-o",
        "StrictHostKeyChecking=yes",
        "-o",
        "ConnectTimeout=2",
        "-o",
        "ConnectionAttempts=1",
        "starship",
    ]
    controls, remote_created = {}, False
    evidence = {
        "gate": "G3-physical-suspend" if sleep_host else "G3-suspend-preparation",
        "sourceCommit": command(["git", "-C", str(ROOT), "rev-parse", "HEAD"])
        .stdout.decode()
        .strip(),
        "sourceTreeDirty": bool(command(["git", "-C", str(ROOT), "status", "--porcelain"]).stdout),
        "sleepHost": sleep_host,
        "endpoints": {},
        "cases": [],
        "limits": [
            "No Rofi rendering, managed rollout or physical Starship desktop acceptance",
            "Preparation mode does not arm an alarm or suspend a host",
            "No automatic reboot, inhibitor bypass or ordinary-session actions",
        ],
    }

    def passed(name, **details):
        evidence["cases"].append({"name": name, "result": "passed", **details})
        print("passed " + name, flush=True)

    def frame(host):
        result = controls[host].call("snapshot")["frame"]
        reader.verify("fleet-frame", result)
        return result

    def ready(host):
        deadline = time.monotonic() + 20
        while time.monotonic() < deadline:
            value = frame(host)
            if all(current(value, target) for target in controls) and value["snapshot"]["desktop"][
                "state"
            ] in ("ready", "unsupported"):
                return value
            time.sleep(0.1)
        raise RuntimeError("owned two-host prepared state did not become ready")

    try:
        from artifact_input import stage_wheel

        wheel = stage_wheel(root / "wheel", evidence, repo=ROOT, descriptor=artifact)
        wheel.rename(root / wheel.name)
        wheel = root / wheel.name
        names = ("accept-native-fleet", "accept-native-suspend")
        for name in names:
            shutil.copyfile(ROOT / "scripts" / name, root / name)
        command([*ssh, "mkdir -m 700 -- " + shlex.quote(str(root))])
        remote_created = True
        command(
            [
                "scp",
                "-q",
                "-o",
                "BatchMode=yes",
                "-o",
                "StrictHostKeyChecking=yes",
                str(wheel),
                *(str(root / name) for name in names),
                "starship:" + str(root) + "/",
            ]
        )
        for host in ("snap", "starship"):
            argv = [
                sys.executable,
                str(root / "accept-native-suspend"),
                "--worker",
                str(root),
                "--host-id",
                host,
            ]
            if host == "starship":
                argv = [*ssh, shlex.join(["python3", *argv[1:]])]
            controls[host] = helper.Control(argv)
            evidence["endpoints"][host] = controls[host].receive()
        digest = hashlib.sha256(wheel.read_bytes()).hexdigest()
        assert all(info["wheelSha256"] == digest for info in evidence["endpoints"].values())
        evidence["before"] = {
            host: {
                "frame": ready(host),
                "native": controls[host].call("native_truth"),
                "preflight": controls[host].call("preflight"),
            }
            for host in controls
        }
        passed("same_installed_wheel_ready_sources_native_baselines_and_dry_rtc_preflight")
        evidence["monitorStarts"] = {
            host: controls[host].call("monitor_start") for host in controls
        }
        if sleep_host:
            evidence["kickoff"] = controls[sleep_host].call("physical_suspend")
            deadline = time.clock_gettime(time.CLOCK_BOOTTIME) + 100
            while time.clock_gettime(time.CLOCK_BOOTTIME) < deadline:
                result = controls[sleep_host].call("power_status")
                if result["state"] in ("failed", "resumed"):
                    evidence["power"] = result
                    break
                time.sleep(0.5)
            else:
                raise RuntimeError("owned power helper exceeded absolute recovery bound")
            assert result["state"] == "resumed", result
            passed(
                "actual_physical_suspend_same_boot_and_guarded_owned_rtc_cleanup",
                suspendDeltaMs=result["suspendDeltaMs"],
            )
        else:
            time.sleep(6)
        evidence["after"] = {
            host: {"frame": ready(host), "native": controls[host].call("native_truth")}
            for host in controls
        }
        evidence["monitors"] = {host: controls[host].call("monitor_finish") for host in controls}
        for host, monitor in evidence["monitors"].items():
            assert len(monitor["samples"]) >= 5
            assert all(row.get("durationMs", 0) <= 250 for row in monitor["samples"])
            for captured in monitor["frames"].values():
                reader.verify("fleet-frame", captured)
            assert evidence["after"][host]["native"] == evidence["before"][host]["native"]
            passed(
                "cached_supervisor_and_native_passivity",
                endpoint=host,
                samples=len(monitor["samples"]),
            )
        if sleep_host:
            peer = "starship" if sleep_host == "snap" else "snap"
            awake = evidence["monitors"][peer]
            invalid = awake["frames"].get("firstRemoteInvalid")
            assert invalid is not None, (
                "awake supervisor did not observe remote authority invalidation"
            )
            for row in awake["samples"]:
                if "hosts" in row:
                    assert row["hosts"][peer]["current"], "awake local source lost authority"
            old_expiry = max(
                row["hosts"][sleep_host]["owner"]["localExpiry"]
                for row in awake["samples"]
                if "hosts" in row
                and row["encodedAt"] < invalid["encodedAt"]
                and row["hosts"][sleep_host]["current"]
            )
            evidence["lastPreInvalidPositiveExpiry"] = old_expiry
            assert invalid["encodedAt"] <= old_expiry + 1500
            resumed = next(
                row
                for row in evidence["monitors"][sleep_host]["samples"]
                if row["suspendDeltaMs"] >= 10_000
            )
            first_clock = resumed["lastBeforeLocalResume"]["boottimeMs"] + resumed["suspendDeltaMs"]
            first_response = resumed["firstResponseAfterLocalResume"]
            if "unavailable" not in first_response:
                reader.verify("fleet-frame", first_response)
            for row in evidence["monitors"][sleep_host]["samples"]:
                if row["clock"]["boottimeMs"] < first_clock or "hosts" not in row:
                    continue
                for target, source in row["hosts"].items():
                    if not source["current"]:
                        continue
                    owner = source["owner"]
                    if target == sleep_host:
                        assert owner["receipt"]["startedAt"] >= first_clock - 500
                    else:
                        assert owner["proof"]["sentAt"] >= first_clock - 500
                desktop = row["desktop"]
                if desktop["state"] == "ready":
                    assert desktop["startedAt"] >= first_clock - 500
            passed("awake_peer_expiry_local_resume_old_proof_rejection_and_fresh_readmission")
        else:
            for host, monitor in evidence["monitors"].items():
                assert all(
                    "hosts" in row and all(source["current"] for source in row["hosts"].values())
                    for row in monitor["samples"]
                )
                assert not any(row["suspendDeltaMs"] >= 10_000 for row in monitor["samples"])
                assert not (root / "power.json").exists()
                assert controls[host].call("preflight")["wakealarmBefore"] == ""
            passed("preparation_left_both_host_power_states_and_rtc_alarms_untouched")
        evidence["result"] = (
            "passed_physical_direction" if sleep_host else "passed_preparation_only"
        )
    except Exception as error:
        evidence.update(
            result="failed", failure={"code": type(error).__name__, "message": str(error)[:2048]}
        )
        raise
    finally:
        output.parent.mkdir(parents=True, exist_ok=True)
        output.write_text(json.dumps(evidence, indent=2) + "\n")
        try:
            for control in reversed(list(controls.values())):
                close_control(control)
            if remote_created:
                command(
                    [
                        *ssh,
                        shlex.join(
                            [
                                "python3",
                                str(root / "accept-native-fleet"),
                                "--cleanup",
                                str(root),
                                "--host-id",
                                "starship",
                            ]
                        ),
                    ]
                )
                command([*ssh, "rm -rf -- " + shlex.quote(str(root))])
            helper.cleanup(root, "snap")
            shutil.rmtree(root)
            evidence["ownedCleanup"] = (
                "both_endpoint_units_children_sockets_and_private_roots_removed"
            )
        except Exception as error:
            evidence.update(
                result="failed_cleanup",
                ownedCleanup={
                    "code": type(error).__name__,
                    "message": str(error)[:1024],
                    "privateRecoveryRoot": str(root),
                },
            )
            raise
        finally:
            output.write_text(json.dumps(evidence, indent=2) + "\n")
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--worker", type=Path)
    parser.add_argument("--power", type=Path)
    parser.add_argument("--host-id", choices=("snap", "starship"))
    parser.add_argument("--output", type=Path)
    parser.add_argument("--artifact", type=Path, help="frozen candidate.json; skip wheel build")
    parser.add_argument(
        "--sleep",
        choices=("snap", "starship"),
        help="physical 30-second whole-host interruption; requires an agreed user test window",
    )
    args = parser.parse_args()
    if args.artifact and (args.worker or args.power or args.host_id):
        parser.error("--artifact is a coordinator input")
    if args.power and not (args.worker or args.output or args.sleep):
        return power(args.power)
    if args.worker and args.host_id and not (args.output or args.sleep):
        worker(args.worker, args.host_id)
        return 0
    if args.output and not (args.worker or args.power or args.host_id):
        return coordinate(args.output, args.sleep, args.artifact)
    parser.error("provide --output, or one complete private worker/power invocation")


if __name__ == "__main__":
    raise SystemExit(main())
