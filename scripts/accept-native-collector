#!/usr/bin/env python3
"""Owned native/installed producer acceptance. Never targets ordinary sockets."""

from __future__ import annotations

import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import platform
import subprocess
import tempfile
import time
import zipfile
from pathlib import Path

from tmux_observer._process import Completed, ReadRunner
from tmux_observer.collector import GENERATION, PENDING, Collector, format_fields

ROOT = Path(__file__).resolve().parent.parent
loader = importlib.machinery.SourceFileLoader(
    "acceptance_reader", str(ROOT / "scripts/read-contract")
)
spec = importlib.util.spec_from_loader(loader.name, loader)
reader = importlib.util.module_from_spec(spec)
loader.exec_module(reader)


def command(args, *, env=None, ok=True):
    result = subprocess.run(args, env=env, capture_output=True, check=False, timeout=30)
    if ok and result.returncode:
        raise RuntimeError(result.stderr.decode(errors="replace")[:4096])
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    evidence = {
        "schemaVersion": 1,
        "gate": "G1",
        "sourceCommit": command(["git", "rev-parse", "HEAD"]).stdout.decode().strip(),
        "nativeVersion": command(["tmux", "-V"]).stdout.decode().strip(),
        "python": platform.python_version(),
        "scope": "owned TMUX_TMPDIR; owned default and alternate servers; no ordinary socket mutations",
        "cases": [],
        "limits": [
            "Suspend deadline evidence is synthetic BOOTTIME injection, not physical suspend",
            "Creation-time conflicts within one generation are synthetic; real restart/reused IDs tested",
            "No service, remote, GUI or managed deployment acceptance",
        ],
    }

    def passed(name, **details):
        evidence["cases"].append({"name": name, "result": "passed", **details})
        print("passed " + name, flush=True)

    with tempfile.TemporaryDirectory(prefix="tmux-observer-native-acceptance-") as temporary:
        directory = Path(temporary)
        env = dict(os.environ, TMUX_TMPDIR=str(directory))
        env.pop("TMUX", None)
        env.pop("TMUX_PANE", None)
        default = ("tmux", "-f", "/dev/null", "-L", "default")
        alternate = ("tmux", "-f", "/dev/null", "-L", "alternate")
        runner = ReadRunner(default)
        runner.env = dict(env, LC_ALL="C")
        collector = Collector("fixture-native", runner=runner)

        def native(*arguments, prefix=default, ok=True):
            return command([*prefix, *arguments], env=env, ok=ok).stdout.decode().removesuffix("\n")

        def collect(selected=collector, **profile):
            value = selected.collect(**profile)
            raw = json.dumps(value, ensure_ascii=False, separators=(",", ":")).encode() + b"\n"
            reader.verify("observation", reader.wire(raw, 1048576))
            return value

        def owned_session(name="owned"):
            native("new-session", "-d", "-s", name, "sleep 120")

        try:
            empty = collect()
            assert (
                empty["sample"]["coverage"] == "complete"
                and empty["serverGeneration"] is None
                and not empty["sessions"]
            )
            assert not (directory / f"tmux-{os.getuid()}" / "default").exists()
            passed("verified absence does not create a server")
            owned_session()
            sid = native("list-sessions", "-F", "#{session_id}")
            baseline = native(
                "list-sessions",
                "-F",
                "#{session_id}|#{session_created}|#{session_attached}|#{session_windows}",
            )
            hooks = native("show-hooks", "-t", sid)
            native("set-option", "-g", PENDING, "global")
            native("set-option", "-t", sid, "@empty", "")
            native("set-option", "-t", sid, "@quoted", "a b;quotes'")
            value = collect(panes=True, option_names=["@empty", "@absent", "@quoted"])
            row = value["sessions"][0]
            assert row["hostId"] == "fixture-native" and row["sessionId"] == sid
            assert row["createdAt"] == int(
                native("display-message", "-p", "-t", sid, "#{session_created}")
            )
            assert row["name"] == native("display-message", "-p", "-t", sid, "#{session_name}")
            assert row["attachedClients"] == int(
                native("display-message", "-p", "-t", sid, "#{session_attached}")
            )
            assert row["panes"][0]["paneId"] == native("list-panes", "-t", sid, "-F", "#{pane_id}")
            assert (
                row["options"] == {"@empty": "", "@absent": None, "@quoted": "a b;quotes'"}
                and not row["pending"]
            )
            passed("independent native identity metadata panes and explicit option comparison")
            timings = []
            for _ in range(10):
                sample = collect()
                assert sample["sample"]["coverage"] == "complete"
                timings.append(sample["sample"]["finishedAt"] - sample["sample"]["startedAt"])
            assert (
                native(
                    "list-sessions",
                    "-F",
                    "#{session_id}|#{session_created}|#{session_attached}|#{session_windows}",
                )
                == baseline
            )
            assert native("show-hooks", "-t", sid) == hooks
            passed(
                "repeated reads preserve attachment counts roster windows and hooks",
                samples=10,
                durationsMs=timings,
            )
            native("set-option", "-t", sid, PENDING, "")
            assert collect()["sessions"][0]["pending"]
            native("rename-session", "-t", sid, "renamed")
            renamed = collect()["sessions"][0]
            assert renamed["name"] == "renamed" and renamed["createdAt"] == row["createdAt"]
            passed("rename and explicit empty pending marker retain identity")

            def legacy(arguments, deadline):
                if arguments == ["display-message", "-p", format_fields(GENERATION)]:
                    return Completed(0, "\t\t\n", "")
                return runner(arguments, deadline)

            legacy_value = collect(
                Collector("fixture-native", runner=legacy), panes=True, option_names=["@empty"]
            )
            assert (
                legacy_value["sample"]["coverage"] == "complete"
                and legacy_value["sessions"][0]["name"] == "renamed"
            )
            passed("native legacy read fallback retains generation and roster checks")

            changed = False

            def disappear(arguments, deadline):
                nonlocal changed
                if not changed and arguments[0] == "show-options":
                    changed = True
                    native("kill-session", "-t", sid)
                return runner(arguments, deadline)

            gone = collect(Collector("fixture-native", runner=disappear))
            assert (
                gone["sample"]["coverage"] == "complete"
                and gone["serverGeneration"] is None
                and not gone["sessions"]
            )
            passed(
                "mid-read disappearance retries to verified absence and reader holds no session alive"
            )

            owned_session()
            first = collect()
            changed = False

            def restart(arguments, deadline):
                nonlocal changed
                if not changed and arguments[0] == "show-options":
                    changed = True
                    native("kill-server")
                    owned_session("restarted")
                return runner(arguments, deadline)

            restarted = collect(Collector("fixture-native", runner=restart))
            assert (
                restarted["sample"]["coverage"] == "complete"
                and restarted["serverGeneration"] != first["serverGeneration"]
            )
            assert restarted["sessions"][0]["sessionId"] == first["sessions"][0]["sessionId"]
            assert restarted["sessions"][0]["name"] == "restarted"
            passed("real server restart and reused session ID reject old generation")
            sid = restarted["sessions"][0]["sessionId"]
            native("set-option", "-g", "exit-empty", "off")
            native("kill-session", "-t", sid)
            live_empty = collect()
            assert (
                live_empty["sample"]["coverage"] == "complete"
                and live_empty["serverGeneration"] is not None
                and not live_empty["sessions"]
            )
            passed("live empty server remains distinct from absent server")
            native("kill-server")

            # Build and invoke the installed CLI with -I, outside source imports.
            artifact_dir = directory / "artifact"
            command(["uv", "build", "--wheel", "--out-dir", str(artifact_dir)])
            wheel = next(artifact_dir.glob("*.whl"))
            evidence["wheelSha256"] = hashlib.sha256(wheel.read_bytes()).hexdigest()
            with zipfile.ZipFile(wheel) as archive:
                names = archive.namelist()
                for path in (ROOT / "contracts").rglob("*"):
                    if path.is_file():
                        suffix = "share/tmux-observer/" + str(path.relative_to(ROOT))
                        matches = [name for name in names if name.endswith(suffix)]
                        assert len(matches) == 1 and archive.read(matches[0]) == path.read_bytes()
            venv = directory / "installed"
            command(["uv", "venv", str(venv)])
            python = str(venv / "bin/python")
            command(["uv", "pip", "install", "--python", python, str(wheel)])
            owned_session("default-owned")
            native("new-session", "-d", "-s", "alternate-owned", "sleep 120", prefix=alternate)
            alternate_path = native("display-message", "-p", "#{socket_path}", prefix=alternate)
            contaminated = dict(env, TMUX=alternate_path + ",1,0", TMUX_PANE="%999")

            def installed(test_env, *profile):
                result = command(
                    [
                        python,
                        "-I",
                        "-m",
                        "tmux_observer",
                        "collect",
                        "--host-id",
                        "fixture-installed",
                        *profile,
                    ],
                    env=test_env,
                    ok=False,
                )
                value = reader.wire(result.stdout, 1048576)
                reader.verify("observation", value)
                return result, value

            result, installed_value = installed(contaminated, "--panes", "--option", "@absent")
            assert (
                result.returncode == 0 and installed_value["sessions"][0]["name"] == "default-owned"
            )
            assert installed_value["source"]["hostId"] == "fixture-installed"
            passed(
                "isolated installed wheel CLI and exact packaged contracts ignore ambient alternate TMUX"
            )
            native("kill-server")
            result, installed_empty = installed(contaminated)
            assert (
                result.returncode == 0
                and installed_empty["serverGeneration"] is None
                and not installed_empty["sessions"]
            )
            native("list-sessions", prefix=alternate)
            passed("installed CLI absent default remains empty while alternate server is alive")
            result, missing = installed(dict(contaminated, PATH="/tmux-observer-owned-missing"))
            assert (
                result.returncode == 1
                and missing["sample"]["coverage"] == "unsupported"
                and missing["sample"]["error"]["code"] == "tmux_missing"
            )
            passed("installed missing executable is unsupported not false empty")
            result = command(
                [python, "-I", "-m", "tmux_observer", "collect", "--host-id", "invalid host"],
                env=env,
                ok=False,
            )
            reader.verify("operation-error", reader.wire(result.stdout, 16384))
            assert result.returncode == 1
            passed("installed invalid context emits typed operation error")
        finally:
            # The temporary TMUX_TMPDIR makes these two sockets task-owned.
            native("kill-server", prefix=default, ok=False)
            native("kill-server", prefix=alternate, ok=False)
    evidence["result"] = "passed"
    evidence["observedAtUnixMs"] = time.time_ns() // 1_000_000
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(evidence, indent=2) + "\n")
    print(
        f"G1 passed: {len(evidence['cases'])} owned native/artifact cases; evidence {args.output}"
    )


if __name__ == "__main__":
    main()
