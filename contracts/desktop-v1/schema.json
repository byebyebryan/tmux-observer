{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tmux-observer.invalid/contracts/desktop-v1/schema.json",
  "type": "object",
  "properties": {
    "protocol": {
      "const": "tmux-observer.desktop.v1"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "clock": {
      "type": "object",
      "properties": {
        "bootId": {
          "type": "string",
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "timeNamespace": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^time:[0-9]+$"
        }
      },
      "required": [
        "bootId",
        "timeNamespace"
      ],
      "additionalProperties": false
    },
    "contextId": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9a-f]{32}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "encodedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "receipt": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "warming",
            "ready",
            "failed",
            "unsupported",
            "expired"
          ]
        },
        "startedAt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "acceptedAt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "inputHash": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
                  "minLength": 1
                },
                "message": {
                  "type": "string",
                  "maxLength": 4096,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "startedAt",
        "acceptedAt",
        "expiresAt",
        "inputHash",
        "error"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hostId": {
            "type": "string",
            "maxLength": 16384,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "minLength": 1
          },
          "local": {
            "type": "boolean"
          },
          "publisherId": {
            "type": "string",
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "serverGeneration": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 16384,
                "pattern": "^[^\\u0000-\\u001f\\u007f]*$",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "ownerExpiresAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "associationExpiresAt": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "hostId",
          "local",
          "publisherId",
          "serverGeneration",
          "ownerExpiresAt",
          "associationExpiresAt"
        ],
        "additionalProperties": false
      },
      "maxItems": 16
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sessionRef": {
            "type": "object",
            "properties": {
              "hostId": {
                "type": "string",
                "maxLength": 16384,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
                "minLength": 1
              },
              "serverGeneration": {
                "type": "string",
                "maxLength": 16384,
                "pattern": "^[^\\u0000-\\u001f\\u007f]*$",
                "minLength": 1
              },
              "sessionId": {
                "type": "string",
                "maxLength": 16384,
                "pattern": "^\\$[0-9]+$"
              },
              "createdAt": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              }
            },
            "required": [
              "hostId",
              "serverGeneration",
              "sessionId",
              "createdAt"
            ],
            "additionalProperties": false
          },
          "attachedClients": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              {
                "type": "null"
              }
            ]
          },
          "presence": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "open",
                  "none",
                  "unknown"
                ]
              },
              "confidence": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "confirmed",
                      "matched"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evidence": {
                "type": "string",
                "enum": [
                  "current_native_association",
                  "qualified_title",
                  "launch_reference",
                  "absence",
                  "unknown"
                ]
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "state",
              "confidence",
              "evidence",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "sessionRef",
          "attachedClients",
          "presence"
        ],
        "additionalProperties": false
      },
      "maxItems": 4096
    }
  },
  "required": [
    "protocol",
    "schemaVersion",
    "clock",
    "contextId",
    "epoch",
    "encodedAt",
    "receipt",
    "dependencies",
    "rows"
  ],
  "additionalProperties": false
}
