{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tmux-observer.invalid/contracts/bindings-v1/schema.json",
  "type": "object",
  "properties": {
    "protocol": {
      "const": "tmux-observer.bindings.v1"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "clock": {
      "type": "object",
      "properties": {
        "bootId": {
          "type": "string",
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "timeNamespace": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^time:[0-9]+$"
        }
      },
      "required": [
        "bootId",
        "timeNamespace"
      ],
      "additionalProperties": false
    },
    "contextId": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9a-f]{32}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "encodedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "hostId": {
      "type": "string",
      "maxLength": 16384,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "minLength": 1
    },
    "publisherId": {
      "type": "string",
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "serverGeneration": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 16384,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "receipt": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "ready",
            "unavailable",
            "unsupported",
            "expired"
          ]
        },
        "preparedAt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "associationStartedAt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "ownerExpiresAt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "associationExpiresAt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
                  "minLength": 1
                },
                "message": {
                  "type": "string",
                  "maxLength": 4096,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "preparedAt",
        "associationStartedAt",
        "ownerExpiresAt",
        "associationExpiresAt",
        "expiresAt",
        "error"
      ],
      "additionalProperties": false
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sessionRef": {
            "type": "object",
            "properties": {
              "hostId": {
                "type": "string",
                "maxLength": 16384,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
                "minLength": 1
              },
              "serverGeneration": {
                "type": "string",
                "maxLength": 16384,
                "pattern": "^[^\\u0000-\\u001f\\u007f]*$",
                "minLength": 1
              },
              "sessionId": {
                "type": "string",
                "maxLength": 16384,
                "pattern": "^\\$[0-9]+$"
              },
              "createdAt": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              }
            },
            "required": [
              "hostId",
              "serverGeneration",
              "sessionId",
              "createdAt"
            ],
            "additionalProperties": false
          },
          "attachedClients": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              {
                "type": "null"
              }
            ]
          },
          "association": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "open",
                  "none",
                  "unknown"
                ]
              },
              "resolvedAt": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
                "minLength": 1
              }
            },
            "required": [
              "state",
              "resolvedAt",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "sessionRef",
          "attachedClients",
          "association"
        ],
        "additionalProperties": false
      },
      "maxItems": 256
    }
  },
  "required": [
    "protocol",
    "schemaVersion",
    "clock",
    "contextId",
    "epoch",
    "encodedAt",
    "hostId",
    "publisherId",
    "serverGeneration",
    "receipt",
    "rows"
  ],
  "additionalProperties": false
}
