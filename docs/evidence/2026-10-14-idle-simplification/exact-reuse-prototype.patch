+def _same_json(value, retained):
+    """Exact plain-JSON equality bounded by the already checked retained shape."""
+    kind = type(value)
+    if kind is not type(retained):
+        return False
+    if kind is dict:
+        return (
+            len(value) == len(retained)
+            and all(type(key) is str and key in retained for key in value)
+            and all(_same_json(value[key], child) for key, child in retained.items())
+        )
+    if kind is list:
+        return len(value) == len(retained) and all(
+            _same_json(left, right) for left, right in zip(value, retained)
+        )
+    return kind in (str, int, float, bool, type(None)) and value == retained
+
